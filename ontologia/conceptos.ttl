# ── PREREQUISITOS ────────────────────────────────────────────────────────────
# Dirección: A esPrerequisitoDe B  →  A debe aprenderse ANTES que B

# Estadística
:Media :esPrerequisitoDe :Mediana .
:Mediana :esPrerequisitoDe :Cuartiles .
:Cuartiles :esPrerequisitoDe :DiagramaCaja .
:Rango :esPrerequisitoDe :DiagramaCaja .
:Probabilidad :esPrerequisitoDe :ProbabilidadCondicional .
:Probabilidad :esPrerequisitoDe :EventosMutuamenteExcluyentes .
:ProbabilidadCondicional :esPrerequisitoDe :TeoremaBayes .
:Probabilidad :esPrerequisitoDe :VariableAleatoria .
:VariableAleatoria :esPrerequisitoDe :DistribucionNormal .

# Álgebra y funciones
:Expresiones :esPrerequisitoDe :Ecuaciones .
:Ecuaciones :esPrerequisitoDe :Inecuaciones .
:Ecuaciones :esPrerequisitoDe :Sistemas .
:Ecuaciones :esPrerequisitoDe :FuncionLineal .
:FuncionLineal :esPrerequisitoDe :FuncionCuadratica .
:FuncionCuadratica :esPrerequisitoDe :FuncionExponencial .
:FuncionExponencial :esPrerequisitoDe :FuncionLogaritmica .
:Polinomios :esPrerequisitoDe :Factorizacion .
:Factorizacion :esPrerequisitoDe :FuncionCuadratica .
:FuncionLineal :esPrerequisitoDe :Sucesiones .

# Geometría
:Angulos :esPrerequisitoDe :Triangulos .
:Triangulos :esPrerequisitoDe :TeoremaPitagoras .
:TeoremaPitagoras :esPrerequisitoDe :Trigonometria .
:Triangulos :esPrerequisitoDe :AreaSuperficies .
:Poligonos :esPrerequisitoDe :AreaSuperficies .
:AreaSuperficies :esPrerequisitoDe :Volumen .
:Angulos :esPrerequisitoDe :Circunferencia .

# Numérico
:NumerosNaturales :esPrerequisitoDe :NumerosEnteros .
:NumerosEnteros :esPrerequisitoDe :NumerosRacionales .
:NumerosRacionales :esPrerequisitoDe :NumerosReales .
:NumerosNaturales :esPrerequisitoDe :Proporcionalidad .
:Proporcionalidad :esPrerequisitoDe :Porcentajes .
:NumerosReales :esPrerequisitoDe :Potenciacion .
:Potenciacion :esPrerequisitoDe :FuncionExponencial .

# Conexiones entre áreas
:NumerosReales :esPrerequisitoDe :Expresiones .
:Media :esSubconceptoDe :Estadistica .
:Mediana :esSubconceptoDe :Estadistica .
:Moda :esSubconceptoDe :Estadistica .

# Área padre (concepto contenedor)
:Estadistica a :ConceptoMatematico ;
    rdfs:label "Estadística descriptiva" .
