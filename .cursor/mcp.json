{
  "mcpServers": {
    "sequential-thinking": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-sequential-thinking"],
      "description": "Razonamiento paso a paso para problemas matemáticos complejos"
    },
    "memory": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-memory"],
      "description": "Persistencia de información entre sesiones"
    },
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest"],
      "description": "Automatización de pruebas y validación de ejercicios generados"
    },
    "filesystem": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "/home/bootcamp/Proyectos-2026/RepositorioMatematicasICFES_R_Exams"],
      "description": "Acceso al sistema de archivos del proyecto"
    },
    "github-git": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@0xshariq/github-mcp-server"],
      "env": {
        "GITHUB_TOKEN": "",
        "REPO_PATH": "/home/bootcamp/Proyectos-2026/RepositorioMatematicasICFES_R_Exams"
      },
      "description": "Operaciones Git locales y GitHub (29 operaciones Git + 11 workflows)"
    },
    "python-executor": {
      "type": "stdio",
      "command": "/home/bootcamp/.local/bin/uvx",
      "args": ["mcp-run-python", "stdio"],
      "description": "Ejecutar código Python en sandbox seguro (Pyodide + Deno)"
    }
  }
}

