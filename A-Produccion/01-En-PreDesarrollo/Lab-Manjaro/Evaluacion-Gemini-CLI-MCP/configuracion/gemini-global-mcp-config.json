{
  "mcpServers": {
    "context7": {
      "command": "node",
      "args": ["/home/proyectos/Insync/alvaroangelm@iepedacitodecielo.edu.co/Google Drive/RepositorioMatematicasICFES_R_Exams/.mcps/context7-mcp/dist/index.js"],
      "env": {
        "UPSTASH_REDIS_REST_URL": "${UPSTASH_REDIS_REST_URL}",
        "UPSTASH_REDIS_REST_TOKEN": "${UPSTASH_REDIS_REST_TOKEN}"
      },
      "description": "Context7 MCP Server for global documentation and code examples",
      "enabled": true,
      "global": true
    },
    "latex-validator": {
      "command": "node",
      "args": ["/home/proyectos/Insync/alvaroangelm@iepedacitodecielo.edu.co/Google Drive/RepositorioMatematicasICFES_R_Exams/.mcps/latex-validator-mcp/index-fixed.js"],
      "env": {},
      "description": "Global LaTeX/TikZ validator for R-exams",
      "enabled": true,
      "global": true
    },
    "image-analysis": {
      "command": "node", 
      "args": ["/home/proyectos/Insync/alvaroangelm@iepedacitodecielo.edu.co/Google Drive/RepositorioMatematicasICFES_R_Exams/.mcps/image-analysis-mcp/index-fixed.js"],
      "env": {},
      "description": "Global image analysis for mathematical graphics and TikZ replication",
      "enabled": true,
      "global": true
    }
  },
  "globalSettings": {
    "autoStart": true,
    "enableLogging": true,
    "logLevel": "info",
    "logFile": "/home/proyectos/.gemini/mcp.log",
    "enableNotifications": true,
    "timeout": 30000,
    "retryAttempts": 3,
    "retryDelay": 1000
  },
  "workspaceSettings": {
    "defaultWorkspace": "/home/proyectos/Insync/alvaroangelm@iepedacitodecielo.edu.co/Google Drive/RepositorioMatematicasICFES_R_Exams",
    "includePaths": [
      "Lab-Manjaro/**/*.Rmd",
      "Lab-Manjaro/**/*.Rnw", 
      "Auxiliares/**/*.tex",
      "Auxiliares/**/*.tikz",
      "**/*.py",
      "**/*.R"
    ],
    "excludePaths": [
      "node_modules/**",
      ".git/**",
      "*.log",
      "*.tmp",
      "*.aux",
      "*.out"
    ]
  },
  "rExamsIntegration": {
    "enabled": true,
    "defaultEngine": "knitr",
    "supportedFormats": ["Rmd", "Rnw"],
    "tikzCompiler": "pdflatex",
    "pythonEngine": "reticulate",
    "enableValidation": true,
    "enableAutoComplete": true,
    "metadataValidation": {
      "icfes": true,
      "extype": true,
      "exsolution": true,
      "exname": true
    }
  },
  "tikzIntegration": {
    "enabled": true,
    "compiler": "pdflatex",
    "libraries": [
      "arrows",
      "shapes", 
      "positioning",
      "calc",
      "pgfplots",
      "datavisualization"
    ],
    "standalone": true,
    "outputFormats": ["pdf", "png", "svg"],
    "enableValidation": true,
    "enableOptimization": true
  },
  "pythonIntegration": {
    "enabled": true,
    "interpreter": "/usr/bin/python3",
    "enableReticulate": true,
    "libraries": [
      "matplotlib",
      "numpy",
      "pandas",
      "seaborn"
    ],
    "enableValidation": true,
    "enableOptimization": true
  }
}
