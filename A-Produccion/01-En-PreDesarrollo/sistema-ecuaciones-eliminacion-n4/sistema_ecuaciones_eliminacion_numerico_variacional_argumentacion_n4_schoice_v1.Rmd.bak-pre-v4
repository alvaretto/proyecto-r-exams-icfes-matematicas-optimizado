```{r data_generation, echo = FALSE, results = "hide"}
library(exams)

## ===========================================================================
## sistema_ecuaciones_eliminacion_..._n4_schoice_v1
## Origen: MAT-2026-1-044 (ERA-2026 Sesión 2, pregunta impresa 44).
## Reglas locales del subproyecto: ./.claude/CLAUDE.md (L-1 .. L-6). LEER antes de editar.
## PROHIBIDO set.seed() aquí: el control del RNG es del llamador (Incidente INC-RNG-RESEED).
## ===========================================================================

## --- helpers (copias inline; regla #21 exige auto-contención del .Rmd) -----
eq_display <- function(tex) {
  paste0("::: {style=\"overflow-x:auto; -webkit-overflow-scrolling:touch; max-width:100%;\"}\n\n",
         "$$", tex, "$$\n\n:::\n")
}
fmt <- function(x) formatC(as.numeric(x), format = "f", digits = 0, big.mark = ".",
                            decimal.mark = ",")
pick <- function(x) x[sample.int(length(x), 1L)]          # Familia 5: seguro con length 1

## ===========================================================================
## 1. CONTEXTOS NARRATIVOS (regla #11: 6 plantillas, 6 estructuras distintas)
## ===========================================================================
contextos <- list(
