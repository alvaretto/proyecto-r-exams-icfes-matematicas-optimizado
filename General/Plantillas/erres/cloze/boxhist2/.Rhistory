library(exams)
knitr::opts_chunk$set(echo = TRUE)
mchoice2string <- function(x) {
# Esta función convierte las respuestas de opción múltiple a formato de cadena.
# Para el paquete exams, las respuestas de opción múltiple deben estar en formato:
# - Para schoice (opción única): una cadena como "10000" donde solo hay un 1 en la posición correcta
# - Para mchoice (opción múltiple): una cadena como "10100" donde hay 1s en las posiciones correctas
# Convertir factores a caracteres si es necesario
if (is.factor(x)) x <- as.character(x)
# Si ya es una cadena, devolverla
if (is.character(x) && length(x) == 1) return(x)
# Si es un vector lógico, convertirlo a formato de cadena para exams
if (is.logical(x)) {
return(paste(as.integer(x), collapse = ""))
} else {
return(as.character(x))
}
}
## DATOS
n <- sample(30:50, 1)
m <- sample(1:4, 1)
s <- runif(1, 0.5, 2)
delta <- ifelse(runif(1) < 0.2, sample(8:12), 0)
p2 <- runif(1, 0.45, 0.55)
sesgada <- izquierda <- FALSE
if(!delta) {
sesgada <- runif(1) < 0.6
izquierda <- runif(1) < 0.3
}
dgpBoxhist <- function(n = 40, media = 0, de = 1, delta = 0,
p2 = 0.5, sesgada = FALSE, izquierda = FALSE)
{
SK <- function(x) abs(diff(diff(fivenum(x)[2:4]))/diff(fivenum(x)[c(2, 4)]))
sim <- function(x){
x <- rnorm(n)
if(sesgada) exp(x) else x
}
x <- sim()
if(sesgada) while(SK(x) < 0.7) x <- sim() else while(SK(x) > 0.15) x <- sim()
if(izquierda) x <- -x
x <- media + de * scale(x)
k <- sample(1:n, round(p2 * n))
x[k] <- x[k] + delta
as.vector(sample(x))
}
x <- round(dgpBoxhist(n = n, media = m, de = s, delta = delta,
p2 = p2, sesgada = sesgada, izquierda = izquierda), digits = 2)
b <- boxplot(x, plot = FALSE)
dispersion <- tol <- signif(diff(range(c(b$stats, b$out)))/25, 1)
write.csv(data.frame(x), file = "boxhist.csv", quote = FALSE, row.names = FALSE)
## PREGUNTA/SOLUCIÓN
preguntas <- soluciones <- explicaciones <- rep(list(""), 6)
tipo <- rep(list("schoice"), 6)
preguntas[[1]] <- c("verdadero", "falso")
# Asegurarse de que solo hay una respuesta correcta para schoice
sol1 <- ifelse(delta < 1, 1, 2)  # 1 = verdadero, 2 = falso
soluciones[[1]] <- paste0(as.integer(1:length(preguntas[[1]]) == sol1), collapse = "")
preguntas[[2]] <- c("simétrica", "sesgada a la derecha", "sesgada a la izquierda")
# Determinar cuál es la opción correcta (1, 2 o 3)
if(!sesgada) {
sol2 <- 1  # simétrica
} else if(sesgada & !izquierda) {
sol2 <- 2  # sesgada a la derecha
} else {
sol2 <- 3  # sesgada a la izquierda
}
soluciones[[2]] <- paste0(as.integer(1:length(preguntas[[2]]) == sol2), collapse = "")
preguntas[[3]] <- c("verdadero", "falso")
sol3 <- ifelse(length(b$out) > 0, 1, 2)  # 1 = verdadero, 2 = falso
soluciones[[3]] <- paste0(as.integer(1:length(preguntas[[3]]) == sol3), collapse = "")
preguntas[[4]] <- ""
soluciones[[4]] <- explicaciones[[4]] <- signif(b$stats[[2]], 3)
tipo[[4]] <- "num"
preguntas[[5]] <- ""
soluciones[[5]] <- explicaciones[[5]] <- signif(b$stats[[4]], 3)
tipo[[5]] <- "num"
menor_mayor <- sample(c("menor", "mayor"), 1)
preguntas[[6]] <- ""
soluciones[[6]] <- explicaciones[[6]] <- signif(b$stats[[3]], 3)
tipo[[6]] <- "num"
# Crear explicaciones para las preguntas de opción única
explicaciones[[1]] <- preguntas[[1]][sol1]
explicaciones[[2]] <- preguntas[[2]][sol2]
explicaciones[[3]] <- preguntas[[3]][sol3]
if(any(explicaciones[4:6] < 0)) explicaciones[4:6] <- lapply(soluciones[4:6], function(x) paste("$", x, "$", sep = ""))
answerlist(unlist(preguntas), markup = "markdown")
par(mfrow = c(1, 2))
boxplot(x, axes = FALSE)
axis(2, at = signif(b$stats, 3), las = 1)
box()
hist(x, freq = FALSE, main = "")
rug(x)
# Asegurarse de que la lista de explicaciones tiene la misma longitud que la lista de preguntas
# Para las preguntas 1-3, ya tenemos explicaciones
# Para las preguntas 4-6 (numéricas), necesitamos crear una lista de explicaciones adecuada
# Crear una lista completa de explicaciones para todas las preguntas
todas_explicaciones <- c(
explicaciones[[1]], # Para pregunta 1
explicaciones[[2]], # Para pregunta 2
explicaciones[[3]], # Para pregunta 3
paste("El primer cuartil es", explicaciones[[4]]), # Para pregunta 4
paste("El tercer cuartil es", explicaciones[[5]]), # Para pregunta 5
paste("La mediana es", explicaciones[[6]])  # Para pregunta 6
)
answerlist(todas_explicaciones, markup = "markdown")
