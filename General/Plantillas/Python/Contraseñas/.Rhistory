tips_count <- 0
tips_fulfilled <- rep(FALSE, 12)
# Consejo 1: Longitud mínima de 8 caracteres
if (nchar(password) >= 8) {
tips_count <- tips_count + 1
tips_fulfilled[1] <- TRUE
} else {
