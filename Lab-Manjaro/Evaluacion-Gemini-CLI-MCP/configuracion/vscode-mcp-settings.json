{
  "mcp.servers": {
    "context7": {
      "command": "node",
      "args": ["/home/proyectos/Insync/alvaroangelm@iepedacitodecielo.edu.co/Google Drive/RepositorioMatematicasICFES_R_Exams/.mcps/context7-mcp/dist/index.js"],
      "env": {
        "UPSTASH_REDIS_REST_URL": "${UPSTASH_REDIS_REST_URL}",
        "UPSTASH_REDIS_REST_TOKEN": "${UPSTASH_REDIS_REST_TOKEN}"
      },
      "description": "Context7 MCP Server for documentation and code examples",
      "enabled": true
    },
    "latex-validator": {
      "command": "node",
      "args": ["/home/proyectos/Insync/alvaroangelm@iepedacitodecielo.edu.co/Google Drive/RepositorioMatematicasICFES_R_Exams/.mcps/latex-validator-mcp/index-fixed.js"],
      "env": {},
      "description": "LaTeX/TikZ validator for R-exams",
      "enabled": true
    },
    "image-analysis": {
      "command": "node",
      "args": ["/home/proyectos/Insync/alvaroangelm@iepedacitodecielo.edu.co/Google Drive/RepositorioMatematicasICFES_R_Exams/.mcps/image-analysis-mcp/index-fixed.js"],
      "env": {},
      "description": "Image analysis for mathematical graphics and TikZ replication",
      "enabled": true
    }
  },
  "mcp.workspace": {
    "rootPath": "/home/proyectos/Insync/alvaroangelm@iepedacitodecielo.edu.co/Google Drive/RepositorioMatematicasICFES_R_Exams",
    "includePaths": [
      "Lab-Manjaro",
      "Auxiliares/Ejemplos-Funcionales-Rmd",
      "Auxiliares/TikZ-Documentation",
      "Auxiliares/Python-Documentation"
    ],
    "excludePaths": [
      "node_modules",
      ".git",
      "*.log",
      "*.tmp"
    ]
  },
  "mcp.features": {
    "autoStart": true,
    "enableLogging": true,
    "logLevel": "info",
    "enableNotifications": true,
    "enableStatusBar": true
  },
  "mcp.r-exams": {
    "defaultEngine": "knitr",
    "supportedFormats": ["Rmd", "Rnw"],
    "tikzCompiler": "pdflatex",
    "pythonEngine": "reticulate",
    "enableValidation": true,
    "enableAutoComplete": true
  },
  "files.associations": {
    "*.Rmd": "rmd",
    "*.Rnw": "rnoweb"
  },
  "editor.quickSuggestions": {
    "other": true,
    "comments": false,
    "strings": true
  },
  "editor.suggest.showWords": false,
  "editor.wordBasedSuggestions": "off",
  "r.rterm.linux": "/usr/bin/R",
  "r.rpath.linux": "/usr/bin/R",
  "python.defaultInterpreterPath": "/usr/bin/python3",
  "latex-workshop.latex.tools": [
    {
      "name": "pdflatex",
      "command": "pdflatex",
      "args": [
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "%DOC%"
      ]
    },
    {
      "name": "tikz-standalone",
      "command": "pdflatex",
      "args": [
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "-shell-escape",
        "%DOC%"
      ]
    }
  ],
  "latex-workshop.latex.recipes": [
    {
      "name": "pdflatex",
      "tools": ["pdflatex"]
    },
    {
      "name": "tikz-standalone",
      "tools": ["tikz-standalone"]
    }
  ]
}
