# Funciones para crear gráficas TikZ - VERSIÓN PROFESIONAL ADAPTADA
crear_grafica_A <- function(h, color) {
  # Adaptando 02-opcion_A_mejorada.tikz
  paste0(
    "\\begin{tikzpicture}[scale=1.2]\n",
    "% Ejes principales con flechas\n",
    "\\draw[thick, ->] (0,0) -- (5.5,0) node[below right] {Ángulo $\\alpha$};\n",
    "\\draw[thick, ->] (0,0) -- (0,3.2) node[above left, rotate=90] {Distancia PK};\n",
    "% Línea horizontal constante - OPCIÓN A\n",
    "\\draw[", color, ", very thick] (0.2,", round(h/2, 1), ") -- (5.2,", round(h/2, 1), ");\n",
    "% Marca de altura h\n",
    "\\draw[black, thick] (1.8,0) -- (1.8,", round(h/2, 1), ");\n",
    "\\node[right] at (1.9,", round(h/4, 1), ") {$h$};\n",
    "% Línea de referencia punteada\n",
    "\\draw[gray!40, dashed, thin] (0,", round(h/2, 1), ") -- (5.5,", round(h/2, 1), ");\n",
    "% Marcas en los ejes\n",
    "\\draw[black] (-0.05,", round(h/2, 1), ") -- (0.05,", round(h/2, 1), ");\n",
    "\\draw[black] (1.8,-0.05) -- (1.8,0.05);\n",
    "% Origen\n",
    "\\fill[black] (0,0) circle (1.5pt);\n",
    "\\end{tikzpicture}"
  )
}

crear_grafica_B <- function(h, color) {
  # Adaptando 03-opcion_B_mejorada.tikz para función cosecante
  paste0(
    "\\begin{tikzpicture}[scale=1.2]\n",
    "% Cuadrícula de fondo sutil\n",
    "\\draw[gray!20, thin] (0,0) grid[step=0.5] (5.5,3.8);\n",
    "% Ejes principales con flechas\n",
    "\\draw[thick, ->] (0,0) -- (5.5,0) node[below right] {Ángulo $\\alpha$};\n",
    "\\draw[thick, ->] (0,0) -- (0,3.8);\n",
    "% Etiqueta del eje Y\n",
    "\\node[above, rotate=90] at (-0.6,1.2) {Distancia PK};\n",
    "% Curva cosecante - OPCIÓN B (CORRECTA)\n",
    "\\draw[", color, ", very thick] (0.8,3.5) .. controls (1.2,2.8) and (1.8,2.2) ..\n",
    "                               (2.5,1.8) .. controls (3.2,1.5) and (4.0,1.3) .. (5.2,1.2);\n",
    "% Puntos importantes marcados\n",
    "\\fill[", color, "] (0.8,3.5) circle (3pt);\n",
    "\\fill[", color, "] (5.2,1.2) circle (3pt);\n",
    "% Líneas punteadas de referencia\n",
    "\\draw[black, dashed, very thick] (0.8,0) -- (0.8,3.5);\n",
    "\\draw[black, dashed, very thick] (5.2,0) -- (5.2,1.2);\n",
    "\\draw[black, dashed, very thick] (0,1.2) -- (5.2,1.2);\n",
    "% Etiquetas de valores\n",
    "\\node[left] at (-0.1,3.5) {$", round(h * 3, 1), "$};\n",
    "\\node[left] at (-0.1,1.2) {$h$};\n",
    "% Marcas en los ejes\n",
    "\\draw[black] (-0.05,3.5) -- (0.05,3.5);\n",
    "\\draw[black] (-0.05,1.2) -- (0.05,1.2);\n",
    "\\draw[black] (0.8,-0.05) -- (0.8,0.05);\n",
    "\\draw[black] (5.2,-0.05) -- (5.2,0.05);\n",
    "% Origen\n",
    "\\fill[black] (0,0) circle (1.5pt);\n",
    "\\end{tikzpicture}"
  )
}

crear_grafica_C <- function(h, color) {
  # Función hiperbólica extrema que replica tu imagen
  paste0(
    "\\begin{tikzpicture}[scale=1.2]\n",
    "% Cuadrícula de fondo sutil\n",
    "\\draw[gray!20, thin] (0,0) grid[step=0.5] (5.5,3.8);\n",
    "% Ejes principales con flechas\n",
    "\\draw[thick, ->] (0,0) -- (5.5,0) node[below right] {Ángulo $\\alpha$};\n",
    "\\draw[thick, ->] (0,0) -- (0,3.8);\n",
    "% Etiqueta del eje Y\n",
    "\\node[above, rotate=90] at (-0.6,1.2) {Distancia PK};\n",
    "% Curva hiperbólica extrema - OPCIÓN C\n",
    "\\draw[", color, ", very thick] (0.2,3.6) .. controls (0.4,2.8) and (0.8,1.8) ..\n",
    "                               (1.5,1.0) .. controls (2.5,0.6) and (4.0,0.3) .. (5.2,0.2);\n",
    "% Puntos importantes marcados\n",
    "\\fill[", color, "] (0.2,3.6) circle (3pt);\n",
    "\\fill[", color, "] (5.2,0.2) circle (3pt);\n",
    "% Líneas punteadas de referencia\n",
    "\\draw[black, dashed, very thick] (0.2,0) -- (0.2,3.6);\n",
    "\\draw[black, dashed, very thick] (5.2,0) -- (5.2,0.2);\n",
    "\\draw[black, dashed, very thick] (0,0.2) -- (5.2,0.2);\n",
    "% Etiquetas de valores\n",
    "\\node[left] at (-0.1,3.6) {$", round(h * 12, 1), "$};\n",
    "\\node[left] at (-0.1,0.2) {$0$};\n",
    "% Marcas en los ejes\n",
    "\\draw[black] (-0.05,3.6) -- (0.05,3.6);\n",
    "\\draw[black] (-0.05,0.2) -- (0.05,0.2);\n",
    "\\draw[black] (0.2,-0.05) -- (0.2,0.05);\n",
    "\\draw[black] (5.2,-0.05) -- (5.2,0.05);\n",
    "% Origen\n",
    "\\fill[black] (0,0) circle (1.5pt);\n",
    "\\end{tikzpicture}"
  )
}

crear_grafica_D <- function(h, color) {
  # Función lineal creciente - OPCIÓN D
  paste0(
    "\\begin{tikzpicture}[scale=1.2]\n",
    "% Cuadrícula de fondo sutil\n",
    "\\draw[gray!20, thin] (0,0) grid[step=0.5] (5.5,3.8);\n",
    "% Ejes principales con flechas\n",
    "\\draw[thick, ->] (0,0) -- (5.5,0) node[below right] {Ángulo $\\alpha$};\n",
    "\\draw[thick, ->] (0,0) -- (0,3.8);\n",
    "% Etiqueta del eje Y\n",
    "\\node[above, rotate=90] at (-0.6,1.2) {Distancia PK};\n",
    "% Línea creciente - OPCIÓN D\n",
    "\\draw[", color, ", very thick] (0.5,0.5) -- (5.2,3.2);\n",
    "% Puntos importantes marcados\n",
    "\\fill[", color, "] (0.5,0.5) circle (3pt);\n",
    "\\fill[", color, "] (5.2,3.2) circle (3pt);\n",
    "% Líneas punteadas de referencia\n",
    "\\draw[black, dashed, very thick] (0.5,0) -- (0.5,0.5);\n",
    "\\draw[black, dashed, very thick] (5.2,0) -- (5.2,3.2);\n",
    "\\draw[black, dashed, very thick] (0,0.5) -- (0.5,0.5);\n",
    "\\draw[black, dashed, very thick] (0,3.2) -- (5.2,3.2);\n",
    "% Etiquetas de valores\n",
    "\\node[left] at (-0.1,0.5) {$", round(h * 0.5, 1), "$};\n",
    "\\node[left] at (-0.1,3.2) {$", round(h * 3, 1), "$};\n",
    "% Marcas en los ejes\n",
    "\\draw[black] (-0.05,0.5) -- (0.05,0.5);\n",
    "\\draw[black] (-0.05,3.2) -- (0.05,3.2);\n",
    "\\draw[black] (0.5,-0.05) -- (0.5,0.05);\n",
    "\\draw[black] (5.2,-0.05) -- (5.2,0.05);\n",
    "% Origen\n",
    "\\fill[black] (0,0) circle (1.5pt);\n",
    "\\end{tikzpicture}"
  )
}

# Función generar_datos() simplificada
generar_datos <- function() {
  h_valor <- sample(c(2, 3, 4, 5), 1)
  color_curva <- sample(c("blue", "red", "green", "purple"), 1)

  punto_inicial <- "Q"
  punto_final <- "T"
  punto_movil <- "K"
  punto_fijo <- "P"

  # Generar las 4 opciones gráficas CON NOMBRES ÚNICOS
  opciones_graficas <- list()
  opciones_graficas$A <- crear_grafica_A(h_valor, color_curva)
  opciones_graficas$B <- crear_grafica_B(h_valor, color_curva)
  opciones_graficas$C <- crear_grafica_C(h_valor, color_curva)  # HIPERBÓLICA NUEVA
  opciones_graficas$D <- crear_grafica_D(h_valor, color_curva)

  # La respuesta correcta es siempre B
  solutions <- c(FALSE, TRUE, FALSE, FALSE)

  return(list(
    h = h_valor,
    color = color_curva,
    punto_inicial = punto_inicial,
    punto_final = punto_final,
    punto_movil = punto_movil,
    punto_fijo = punto_fijo,
    graficas = opciones_graficas,
    solutions = solutions
  ))
}

# Generar datos para este ejercicio
datos <- generar_datos()
@

\begin{question}

Un punto \Sexpr{datos$punto_movil} se mueve de un extremo a otro del segmento \Sexpr{datos$punto_inicial}\Sexpr{datos$punto_final}.

<<echo=FALSE, results=tex>>=
# Gráfica del enunciado adaptada del archivo profesional
grafica_enunciado <- paste0(
  "\\begin{tikzpicture}[scale=1.2]\n",
  "% Segmento horizontal QT\n",
  "\\draw[thick] (0,0) -- (6,0);\n",
  "% Puntos principales\n",
  "\\fill[black] (0,0) circle (2pt) node[above] {$", datos$punto_inicial, "$};\n",
  "\\fill[black] (6,0) circle (2pt) node[above] {$", datos$punto_final, "$};\n",
  "\\fill[cyan] (3.5,0) circle (2pt) node[above] {$", datos$punto_movil, "$};\n",
  "% Punto P debajo del segmento\n",
  "\\fill[black] (6,-1.0) circle (2pt) node[below] {$", datos$punto_fijo, "$};\n",
  "% Línea punteada KP\n",
  "\\draw[very thick, dashed] (3.5,0) -- (6,-1.0);\n",
  "% Línea punteada vertical de P hacia arriba\n",
  "\\draw[thick, dashed] (6,-1.0) -- (6,0);\n",
  "% Ángulo α en el punto K\n",
  "\\draw[cyan, thick] (3.7,0) arc (0:-21.80:0.2);\n",
  "\\node[black] at (4.1,-0.1) {$\\alpha$};\n",
  "% Cuadrado azul en T (ángulo recto)\n",
  "\\fill[cyan] (5.8,-0.12) rectangle (6,0);\n",
  "\\draw[cyan, thick] (5.8,-0.12) rectangle (6,0);\n",
  "% Medida h\n",
  "\\node[right] at (6.05,-0.5) {$h$};\n",
  "\\end{tikzpicture}"
)

include_tikz(grafica_enunciado, name = "grafica_enunciado_v3",
  format = typ, width = "8cm", packages = c("tikz", "pgfplots"))
@

El ángulo $\alpha$ y la medida $h$ se relacionan mediante $\sin(\alpha) = \frac{h}{\Sexpr{datos$punto_movil}\Sexpr{datos$punto_fijo}}$, de donde se deduce $\Sexpr{datos$punto_movil}\Sexpr{datos$punto_fijo} = \frac{h}{\sin(\alpha)} = h \times \csc(\alpha)$.

¿Cuál gráfica muestra las distancias $\Sexpr{datos$punto_movil}\Sexpr{datos$punto_fijo}$ cuando \Sexpr{datos$punto_movil} se mueve sobre el segmento?

\begin{answerlist}
\item
<<echo=FALSE, results=tex>>=
include_tikz(datos$graficas$A, name = "grafica_A_v3",
  format = typ, width = "5cm", packages = c("tikz", "pgfplots"))
@

\item
<<echo=FALSE, results=tex>>=
include_tikz(datos$graficas$B, name = "grafica_B_v3",
  format = typ, width = "5cm", packages = c("tikz", "pgfplots"))
@

\item
<<echo=FALSE, results=tex>>=
include_tikz(datos$graficas$C, name = "grafica_C_v3",
  format = typ, width = "5cm", packages = c("tikz", "pgfplots"))
@

\item
<<echo=FALSE, results=tex>>=
include_tikz(datos$graficas$D, name = "grafica_D_v3",
  format = typ, width = "5cm", packages = c("tikz", "pgfplots"))
@

\end{answerlist}

\end{question}

\begin{solution}

La relación es $\Sexpr{datos$punto_movil}\Sexpr{datos$punto_fijo} = h \times \csc(\alpha) = \frac{h}{\sin(\alpha)}$.

Cuando $\alpha$ es pequeño: $\sin(\alpha) \approx 0$, entonces $\csc(\alpha) \to \infty$.
Cuando $\alpha \to 90$ grados: $\sin(\alpha) \to 1$, entonces $\csc(\alpha) \to 1$.

La gráfica debe mostrar una función cosecante decreciente.

La respuesta correcta es B.

<<echo=FALSE, results=tex>>=
answerlist(ifelse(datos$solutions, "Verdadero", "Falso"))
@

\end{solution}

%% META-INFORMATION
\exname{Trigonometria Punto Movil v3}
\extype{schoice}
\exsolution{\Sexpr{mchoice2string(datos$solutions)}}
\exshuffle{TRUE}
\exsection{Geometria Metrica}

\end{enumerate}
