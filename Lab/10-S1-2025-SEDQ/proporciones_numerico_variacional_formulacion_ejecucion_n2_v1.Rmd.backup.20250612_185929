# Función principal de generación de datos
generar_datos <- function() {
  # Contextos posibles
  contextos <- list(
    list(entidad = "Ministerio de Transporte", elemento = "vehículos", condicion = "asegurados"),
    list(entidad = "DANE", elemento = "hogares", condicion = "con internet"),
    list(entidad = "Ministerio de Educación", elemento = "estudiantes", condicion = "becados"),
    list(entidad = "Superintendencia Financiera", elemento = "empresas", condicion = "certificadas"),
    list(entidad = "ICBF", elemento = "familias", condicion = "beneficiarias"),
    list(entidad = "Ministerio de Salud", elemento = "centros médicos", condicion = "acreditados")
  )
  
  # Seleccionar contexto aleatorio
  contexto <- sample(contextos, 1)[[1]]
  
  # Fracciones posibles (numerador menor que denominador)
  fracciones <- list(
    list(num = 1, den = 3), list(num = 2, den = 5), list(num = 3, den = 7),
    list(num = 4, den = 9), list(num = 2, den = 7), list(num = 3, den = 8),
    list(num = 1, den = 4), list(num = 3, den = 5), list(num = 5, den = 8),
    list(num = 2, den = 9), list(num = 4, den = 7), list(num = 1, den = 5)
  )
  
  fraccion <- sample(fracciones, 1)[[1]]
  
  # Total de elementos (entre 500,000 y 5,000,000)
  total <- sample(seq(500000, 5000000, 100000), 1)
  
  # Calcular cantidad que cumple la condición
  cantidad_condicion <- total * fraccion$num / fraccion$den
  
  # Generar distractores
  distractor_doble <- total * 2
  distractor_promedio <- total / 2
  distractor_porcentaje <- (fraccion$num / fraccion$den) * 100
  
  return(list(
    entidad = contexto$entidad,
    elemento = contexto$elemento,
    condicion = contexto$condicion,
    total = total,
    numerador = fraccion$num,
    denominador = fraccion$den,
    cantidad_condicion = cantidad_condicion,
    distractor_doble = distractor_doble,
    distractor_promedio = distractor_promedio,
    distractor_porcentaje = distractor_porcentaje
  ))
}

# Función para corregir concordancia de género
corregir_concordancia_genero <- function(elemento, adjetivo) {
  # Diccionario de géneros para elementos comunes
  generos_masculinos <- c("vehículos", "hogares", "estudiantes", "centros médicos")
  generos_femeninos <- c("familias", "empresas")

  # Diccionario de adjetivos con sus formas
  adjetivos_formas <- list(
    "matriculado" = list(masc_sing = "matriculado", masc_plur = "matriculados",
                        fem_sing = "matriculada", fem_plur = "matriculadas"),
    "registrado" = list(masc_sing = "registrado", masc_plur = "registrados",
                       fem_sing = "registrada", fem_plur = "registradas"),
    "beneficiario" = list(masc_sing = "beneficiario", masc_plur = "beneficiarios",
                         fem_sing = "beneficiaria", fem_plur = "beneficiarias"),
    "asegurado" = list(masc_sing = "asegurado", masc_plur = "asegurados",
                      fem_sing = "asegurada", fem_plur = "aseguradas"),
    "certificado" = list(masc_sing = "certificado", masc_plur = "certificados",
                        fem_sing = "certificada", fem_plur = "certificadas"),
    "acreditado" = list(masc_sing = "acreditado", masc_plur = "acreditados",
                       fem_sing = "acreditada", fem_plur = "acreditadas"),
    "becado" = list(masc_sing = "becado", masc_plur = "becados",
                   fem_sing = "becada", fem_plur = "becadas")
  )

  # Determinar género y número
  es_femenino <- elemento %in% generos_femeninos
  es_plural <- TRUE  # Asumimos plural por defecto para elementos como "familias"

  # Buscar la forma base del adjetivo
  adjetivo_base <- str_extract(adjetivo, "^[a-z]+")

  if (adjetivo_base %in% names(adjetivos_formas)) {
    formas <- adjetivos_formas[[adjetivo_base]]

    if (es_femenino && es_plural) {
      return(formas$fem_plur)
    } else if (es_femenino && !es_plural) {
      return(formas$fem_sing)
    } else if (!es_femenino && es_plural) {
      return(formas$masc_plur)
    } else {
      return(formas$masc_sing)
    }
  }

  return(adjetivo)  # Si no se encuentra, devolver original
}

# Función para corregir errores semánticos comunes
corregir_semantica <- function(texto, elemento, condicion) {
  # Diccionario completo de correcciones específicas
  correcciones_especificas <- list(
    # Errores con "matriculados"
    "familias matriculados" = "familias matriculadas",
    "empresas matriculados" = "empresas matriculadas",

    # Errores con "registrados"
    "familias registrados" = "familias registradas",
    "empresas registrados" = "empresas registradas",

    # Errores con "certificados"
    "familias certificados" = "familias certificadas",
    "empresas certificados" = "empresas certificadas",

    # Errores con "beneficiarios"
    "familias beneficiarios" = "familias beneficiarias",
    "empresas beneficiarios" = "empresas beneficiarias",

    # Errores con "asegurados"
    "familias asegurados" = "familias aseguradas",
    "empresas asegurados" = "empresas aseguradas",

    # Errores con "acreditados"
    "familias acreditados" = "familias acreditadas",
    "empresas acreditados" = "empresas acreditadas",

    # Errores con "becados"
    "familias becados" = "familias becadas",
    "empresas becados" = "empresas becadas"
  )

  # Aplicar todas las correcciones específicas
  for (error in names(correcciones_especificas)) {
    texto <- str_replace_all(texto, fixed(error), correcciones_especificas[[error]])
  }

  # Corrección dinámica basada en elemento y condición
  if (str_detect(texto, "matriculados|registrados|certificados|beneficiarios|asegurados|acreditados|becados")) {
    condicion_corregida <- corregir_concordancia_genero(elemento, condicion)

    # Reemplazar formas masculinas incorrectas
    patrones_masculinos <- c("matriculados", "registrados", "certificados",
                           "beneficiarios", "asegurados", "acreditados", "becados")

    for (patron in patrones_masculinos) {
      if (str_detect(texto, paste(elemento, patron))) {
        texto <- str_replace_all(texto,
                               paste(elemento, patron),
                               paste(elemento, condicion_corregida))
      }
    }
  }

  return(texto)
}

# Función para validar coherencia del texto
validar_coherencia <- function(entidad, elemento, condicion, total) {
  errores <- c()

  # Validar que la entidad sea coherente con el elemento
  coherencias <- list(
    "ICBF" = c("familias"),
    "Ministerio de Transporte" = c("vehículos"),
    "DANE" = c("hogares"),
    "Ministerio de Educación" = c("estudiantes"),
    "Superintendencia Financiera" = c("empresas"),
    "Ministerio de Salud" = c("centros médicos")
  )

  if (entidad %in% names(coherencias)) {
    if (!(elemento %in% coherencias[[entidad]])) {
      errores <- c(errores, paste("Incoherencia: ", entidad, " no maneja ", elemento))
    }
  }

  # Validar que el total sea realista
  if (total < 1000 || total > 10000000) {
    errores <- c(errores, "Total fuera de rango realista")
  }

  return(errores)
}

# Función para detectar y corregir todos los errores de concordancia
corregir_todos_errores_concordancia <- function(texto) {
  # Patrones de errores comunes (sustantivo femenino + adjetivo masculino)
  errores_concordancia <- c(
    "familias matriculados" = "familias matriculadas",
    "familias registrados" = "familias registradas",
    "familias certificados" = "familias certificadas",
    "familias beneficiarios" = "familias beneficiarias",
    "familias asegurados" = "familias aseguradas",
    "familias acreditados" = "familias acreditadas",
    "familias becados" = "familias becadas",

    "empresas matriculados" = "empresas matriculadas",
    "empresas registrados" = "empresas registradas",
    "empresas certificados" = "empresas certificadas",
    "empresas beneficiarios" = "empresas beneficiarias",
    "empresas asegurados" = "empresas aseguradas",
    "empresas acreditados" = "empresas acreditadas",
    "empresas becados" = "empresas becadas"
  )

  # Aplicar todas las correcciones
  for (error in names(errores_concordancia)) {
    texto <- str_replace_all(texto, fixed(error), errores_concordancia[[error]])
  }

  return(texto)
}

# Función para aplicar correcciones de estilo
aplicar_correcciones_estilo <- function(texto) {
  # Primero corregir errores de concordancia
  texto <- corregir_todos_errores_concordancia(texto)

  # Corregir espaciado
  texto <- str_replace_all(texto, "\\s+", " ")
  texto <- str_trim(texto)

  # Corregir puntuación
  texto <- str_replace_all(texto, "\\s+\\.", ".")
  texto <- str_replace_all(texto, "\\s+,", ",")
  texto <- str_replace_all(texto, "\\s+:", ":")

  # Asegurar mayúscula después de punto
  texto <- str_replace_all(texto, "\\. ([a-z])", ". \\U\\1")

  return(texto)
}

