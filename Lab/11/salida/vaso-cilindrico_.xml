<answer fraction="0" format="html">
<text><![CDATA[<p>
Al área lateral del vaso: 175.93 cm²
</p>]]></text>
<feedback format="html">
<text><![CDATA[<p>
Falso
</p>]]></text>
</feedback>
</answer>
<answer fraction="0" format="html">
<text><![CDATA[<p>
Al área de la tapa del vaso: 50.27 cm²
</p>]]></text>
<feedback format="html">
<text><![CDATA[<p>
Falso
</p>]]></text>
</feedback>
</answer>
<answer fraction="0" format="html">
<text><![CDATA[<p>
Al perímetro de la tapa del vaso: 25.13 cm
</p>]]></text>
<feedback format="html">
<text><![CDATA[<p>
Falso
</p>]]></text>
</feedback>
</answer>
<answer fraction="100" format="html">
<text><![CDATA[<p>
Al volumen del vaso: 351.86 cm³
</p>]]></text>
<feedback format="html">
<text><![CDATA[<p>
Verdadero
</p>]]></text>
</feedback>
</answer>
