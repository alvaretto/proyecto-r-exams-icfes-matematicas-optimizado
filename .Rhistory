source("~/Insync/alvaroangelm@iepedacitodecielo.edu.co/Google Drive/Proyecto-Rexams-2025/r_exams_project/Repositorio_Matematicas_ICFES_PISA/Estadistica/Graficos_Estadisticos_Adopcion_Mascotas/SemilleroUnico.R")
library(exams)
knitr::opts_chunk$set(echo = TRUE)
# Número de datos en el conjunto
n_datos <- sample(10:20, 1)
# Generar datos aleatorios (simulando edades)
datos <- round(rnorm(n_datos, mean = 30, sd = 5))
# Calcular la media
media <- round(mean(datos), 2)
# Calcular la mediana
mediana <- median(datos)
# Calcular la moda
moda <- as.numeric(names(sort(table(datos), decreasing = TRUE))[1])
# Crear opciones incorrectas para la media
opciones_media <- round(rnorm(4, mean = media, sd = 2), 2)
opciones_media <- c(media, opciones_media)
opciones_media <- unique(opciones_media) # Eliminar duplicados
# Ensure exactly 5 options
while(length(opciones_media) < 5) {
new_option <- round(rnorm(1, mean = media, sd = 2), 2)
if(!new_option %in% opciones_media) opciones_media <- c(opciones_media, new_option)
}
opciones_media <- opciones_media[1:5] # Take exactly 5
opciones_media <- sample(opciones_media)
opciones_media <- as.character(opciones_media) # Convertir a caracter
# Crear opciones incorrectas para la mediana
opciones_mediana <- sample(mediana - 5:5, 4)
opciones_mediana <- c(mediana, opciones_mediana)
opciones_mediana <- unique(opciones_mediana) # Eliminar duplicados
# Ensure exactly 5 options
while(length(opciones_mediana) < 5) {
new_option <- sample(mediana - 10:10, 1)
if(!new_option %in% opciones_mediana) opciones_mediana <- c(opciones_mediana, new_option)
}
opciones_mediana <- opciones_mediana[1:5] # Take exactly 5
opciones_mediana <- sample(opciones_mediana)
opciones_mediana <- as.character(opciones_mediana) # Convertir a caracter
# Crear opciones incorrectas para la moda
opciones_moda <- sample(moda - 5:5, 4)
opciones_moda <- c(moda, opciones_moda)
opciones_moda <- unique(opciones_moda) # Eliminar duplicados
# Ensure exactly 5 options
while(length(opciones_moda) < 5) {
new_option <- sample(moda - 10:10, 1)
if(!new_option %in% opciones_moda) opciones_moda <- c(opciones_moda, new_option)
}
opciones_moda <- opciones_moda[1:5] # Take exactly 5
opciones_moda <- sample(opciones_moda)
opciones_moda <- as.character(opciones_moda) # Convertir a caracter
# Create solution vectors (TRUE/FALSE)
sol_media_vec <- as.numeric(opciones_media == as.character(media))
sol_mediana_vec <- as.numeric(opciones_mediana == as.character(mediana))
sol_moda_vec <- as.numeric(opciones_moda == as.character(moda))
answerlist(opciones_media, markup = "markdown")
answerlist(opciones_mediana, markup = "markdown")
answerlist(opciones_moda, markup = "markdown")
setwd("~/Insync/alvaroangelm@iepedacitodecielo.edu.co/Google Drive/RepositorioMatematicasICFES_R_Exams/Lab/01-MeMedModa")
