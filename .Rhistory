ax.hlines(stats['maximo'], box_x - 0.1, box_x + 0.1, colors='black', linewidth=2)
# Etiquetas
offset_x = 0.15
ax.text(box_x + offset_x, stats['minimo'], f'Mín: {stats[\"minimo\"]}',
va='center', ha='left', fontweight='bold', fontsize=10)
ax.text(box_x + offset_x, stats['q1'], f'Q1: {stats[\"q1\"]:.1f}',
va='center', ha='left', fontweight='bold', fontsize=10)
ax.text(box_x + offset_x, stats['mediana'], f'Med: {stats[\"mediana\"]:.1f}',
va='center', ha='left', fontweight='bold', fontsize=10, color='darkred')
ax.text(box_x + offset_x, stats['q3'], f'Q3: {stats[\"q3\"]:.1f}',
va='center', ha='left', fontweight='bold', fontsize=10)
ax.text(box_x + offset_x, stats['maximo'], f'Máx: {stats[\"maximo\"]}',
va='center', ha='left', fontweight='bold', fontsize=10)
# Configuración de ejes
ax.set_xlim(0.3, 1.8)
ax.set_ylim(stats['minimo'] - 5, stats['maximo'] + 5)
ax.set_ylabel('Estatura (cm)', fontweight='bold', fontsize=12)
ax.set_title(titulo, fontweight='bold', fontsize=14, pad=20)
ax.set_xticks([])
ax.grid(True, alpha=0.3, axis='y')
return fig
")
# Generar diagramas para cada opción
for (i in seq_along(opciones_mezcladas)) {
stats <- opciones_mezcladas[[i]]
color <- colores_seleccionados[i]
titulo <- paste("Opción", LETTERS[i])
py_run_string(sprintf("
stats = %s
color = '%s'
titulo = '%s'
fig = crear_diagrama(stats, color, titulo)
fig.savefig('diagrama_opcion_%s.png', dpi=200, bbox_inches='tight')
plt.close(fig)
", jsonlite::toJSON(stats, auto_unbox = TRUE), color, titulo, letters[i]))
}
} else {
# Fallback usando ggplot2
library(ggplot2)
for (i in seq_along(opciones_mezcladas)) {
stats <- opciones_mezcladas[[i]]
df_box <- data.frame(
x = 1,
ymin = stats$minimo,
lower = stats$q1,
middle = stats$mediana,
upper = stats$q3,
ymax = stats$maximo
)
p <- ggplot(df_box, aes(x = x)) +
geom_boxplot(aes(ymin = ymin, lower = lower, middle = middle,
upper = upper, ymax = ymax),
stat = "identity",
fill = colores_seleccionados[i],
alpha = 0.7,
color = "black",
size = 1) +
labs(title = paste("Opción", LETTERS[i]),
y = paste(contexto_seleccionado$variable, "(", contexto_seleccionado$unidad, ")")) +
theme_minimal() +
theme(axis.text.x = element_blank(),
axis.ticks.x = element_blank(),
plot.title = element_text(hjust = 0.5, size = 14, face = "bold")) +
xlim(0.5, 1.5)
ggsave(paste0("diagrama_opcion_", letters[i], ".png"),
plot = p, width = 8, height = 6, dpi = 200)
}
}
# Mostrar diagramas para cada opción
formatos_moodle <- c("exams2moodle", "exams2qti12", "exams2qti21", "exams2openolat")
es_moodle <- (match_exams_call() %in% formatos_moodle)
cat("### Opciones de diagramas de caja:\n\n")
for (i in seq_along(opciones_mezcladas)) {
letra_opcion <- LETTERS[i]
archivo_imagen <- paste0("diagrama_opcion_", letters[i], ".png")
cat(paste0("**", letra_opcion, ".**\n\n"))
if (es_moodle) {
cat(paste0("![](", archivo_imagen, "){width=70%}\n\n"))
} else {
cat(paste0("![](", archivo_imagen, "){width=80%}\n\n"))
}
}
# =============================================================================
# EJERCICIO OPTIMIZADO: CUARTILES Y DIAGRAMAS DE CAJA - VERSIÓN CORREGIDA
# =============================================================================
# Versión: 3.0 - CORREGIDA tras control de calidad
# Fecha: 2025-01-27
# Mejoras: Tabla visible, gráficos garantizados, validación completa
# Compatibilidad: Moodle 4.3, exams2moodle, exams2pdf, exams2html
# =============================================================================
# Configuración global optimizada
Sys.setlocale(category = "LC_NUMERIC", locale = "C")
options(OutDec = ".")
# Cargar bibliotecas
library(exams)
library(knitr)
library(ggplot2)
# Detectar formato de salida
typ <- match_exams_device()
options(scipen = 999)
# Configuración de chunks
knitr::opts_chunk$set(
warning = FALSE,
message = FALSE,
echo = FALSE,
fig.showtext = FALSE,
fig.cap = "",
fig.keep = 'all',
dev = c("png", "pdf"),
dpi = 200,
fig.pos = "H",
cache = FALSE
)
# =============================================================================
# ALEATORIZACIÓN AVANZADA
# =============================================================================
options(OutDec = ".")
set.seed(sample(1:100000, 1))
# CONTEXTOS ALEATORIOS
contextos_estudio <- list(
list(
lugar = "universidad",
poblacion = "estudiantes",
variable = "estatura",
unidad = "centímetros",
contexto_desc = "Un estudio en una universidad registró las estaturas de estudiantes"
),
list(
lugar = "empresa",
poblacion = "empleados",
variable = "estatura",
unidad = "centímetros",
contexto_desc = "Una empresa realizó un estudio de las estaturas de sus empleados"
),
list(
lugar = "equipo deportivo",
poblacion = "atletas",
variable = "estatura",
unidad = "centímetros",
contexto_desc = "Un equipo deportivo registró las estaturas de sus atletas"
)
)
contexto_seleccionado <- sample(contextos_estudio, 1)[[1]]
# GENERACIÓN DE DATOS VÁLIDOS
n_datos <- sample(25:35, 1)
media_base <- sample(160:175, 1)
desviacion_base <- sample(8:12, 1)
generar_datos_validos <- function(n, media, desv) {
repeat {
datos_raw <- rnorm(n, mean = media, sd = desv)
datos <- round(pmax(140, pmin(200, datos_raw)))
# Validar separación entre cuartiles
q1 <- quantile(datos, 0.25, type = 7)
q2 <- quantile(datos, 0.50, type = 7)
q3 <- quantile(datos, 0.75, type = 7)
if (abs(q2 - q1) >= 2 && abs(q3 - q2) >= 2 &&
(max(datos) - min(datos)) >= 15 &&
length(unique(datos)) >= 10) {
return(datos)
}
}
}
datos_estaturas <- generar_datos_validos(n_datos, media_base, desviacion_base)
# CÁLCULO DE ESTADÍSTICOS
calcular_estadisticos <- function(datos) {
list(
minimo = min(datos),
q1 = as.numeric(quantile(datos, 0.25, type = 7)),
mediana = as.numeric(quantile(datos, 0.50, type = 7)),
q3 = as.numeric(quantile(datos, 0.75, type = 7)),
maximo = max(datos),
datos_ordenados = sort(datos)
)
}
estadisticos <- calcular_estadisticos(datos_estaturas)
# DISTRACTORES INTELIGENTES
generar_distractores <- function(stats_correctos) {
list(
# Intercambiar Q1 y Q3
list(
minimo = stats_correctos$minimo,
q1 = stats_correctos$q3,
mediana = stats_correctos$mediana,
q3 = stats_correctos$q1,
maximo = stats_correctos$maximo
),
# Percentiles incorrectos
list(
minimo = stats_correctos$minimo,
q1 = stats_correctos$q1 - 3,
mediana = stats_correctos$mediana,
q3 = stats_correctos$q3 + 3,
maximo = stats_correctos$maximo
),
# Desplazamiento sistemático
list(
minimo = stats_correctos$minimo + 5,
q1 = stats_correctos$q1 + 5,
mediana = stats_correctos$mediana + 5,
q3 = stats_correctos$q3 + 5,
maximo = stats_correctos$maximo + 5
)
)
}
distractores <- generar_distractores(estadisticos)
todas_opciones <- c(list(estadisticos), distractores)
indices_mezclados <- sample(1:length(todas_opciones))
opciones_mezcladas <- todas_opciones[indices_mezclados]
posicion_correcta <- which(indices_mezclados == 1)
solucion <- rep(0, length(opciones_mezcladas))
solucion[posicion_correcta] <- 1
# COLORES PARA GRÁFICOS
colores_seleccionados <- c("#2E86AB", "#A23B72", "#F18F01", "#C73E1D")
# =============================================================================
# TABLA DE DATOS VISIBLE
# =============================================================================
# Organizar datos en tabla
datos_para_tabla <- estadisticos$datos_ordenados
n_columnas <- 6
n_filas <- ceiling(length(datos_para_tabla) / n_columnas)
# Completar con espacios vacíos
datos_completos <- c(datos_para_tabla, rep("", n_columnas * n_filas - length(datos_para_tabla)))
matriz_datos <- matrix(datos_completos, nrow = n_filas, ncol = n_columnas, byrow = TRUE)
# Crear tabla HTML
cat('<div style="text-align: center; margin: 20px 0;">\n')
cat('<h4>Datos de', contexto_seleccionado$variable, 'en', contexto_seleccionado$unidad, '</h4>\n')
cat('<table border="1" style="border-collapse: collapse; margin: 0 auto; font-family: Arial;">\n')
for (i in 1:nrow(matriz_datos)) {
cat('<tr>\n')
for (j in 1:ncol(matriz_datos)) {
valor <- matriz_datos[i, j]
if (valor != "") {
cat('<td style="padding: 8px; text-align: center; border: 1px solid #ccc;">', valor, '</td>\n')
} else {
cat('<td style="padding: 8px; text-align: center; border: 1px solid #ccc;"></td>\n')
}
}
cat('</tr>\n')
}
cat('</table>\n')
cat('</div>\n')
# =============================================================================
# GENERAR DIAGRAMAS DE CAJA GARANTIZADOS
# =============================================================================
for (i in seq_along(opciones_mezcladas)) {
stats <- opciones_mezcladas[[i]]
# Crear data frame para ggplot
df_box <- data.frame(
x = 1,
ymin = stats$minimo,
lower = stats$q1,
middle = stats$mediana,
upper = stats$q3,
ymax = stats$maximo
)
# Crear gráfico
p <- ggplot(df_box, aes(x = x)) +
geom_boxplot(aes(ymin = ymin, lower = lower, middle = middle,
upper = upper, ymax = ymax),
stat = "identity",
fill = colores_seleccionados[i],
alpha = 0.7,
color = "black",
linewidth = 1.2) +
labs(title = paste("Opción", LETTERS[i]),
y = paste(contexto_seleccionado$variable, "(", contexto_seleccionado$unidad, ")")) +
theme_minimal() +
theme(
axis.text.x = element_blank(),
axis.ticks.x = element_blank(),
plot.title = element_text(hjust = 0.5, size = 16, face = "bold"),
axis.title.y = element_text(size = 12, face = "bold"),
panel.grid.major.x = element_blank(),
panel.grid.minor.x = element_blank(),
plot.margin = margin(20, 20, 20, 20)
) +
xlim(0.5, 1.5) +
ylim(stats$minimo - 10, stats$maximo + 10) +
# Añadir etiquetas de valores
annotate("text", x = 1.25, y = stats$minimo,
label = paste("Mín:", stats$minimo), hjust = 0, size = 3.5, fontface = "bold") +
annotate("text", x = 1.25, y = stats$q1,
label = paste("Q1:", round(stats$q1, 1)), hjust = 0, size = 3.5, fontface = "bold") +
annotate("text", x = 1.25, y = stats$mediana,
label = paste("Med:", round(stats$mediana, 1)), hjust = 0, size = 3.5,
fontface = "bold", color = "darkred") +
annotate("text", x = 1.25, y = stats$q3,
label = paste("Q3:", round(stats$q3, 1)), hjust = 0, size = 3.5, fontface = "bold") +
annotate("text", x = 1.25, y = stats$maximo,
label = paste("Máx:", stats$maximo), hjust = 0, size = 3.5, fontface = "bold")
# Guardar gráfico
nombre_archivo <- paste0("diagrama_opcion_", letters[i], ".png")
ggsave(nombre_archivo, plot = p, width = 6, height = 4, dpi = 200, bg = "white")
# Mostrar gráfico en el documento
cat("\n**", LETTERS[i], ".**\n\n")
cat("![](", nombre_archivo, "){width=80%}\n\n")
}
