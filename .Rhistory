library(exams)
knitr::opts_chunk$set(echo = FALSE)
# Número de datos en el conjunto
n_datos <- sample(10:20, 1)
# Generar datos aleatorios (simulando edades)
datos <- round(rnorm(n_datos, mean = 30, sd = 5))
# Calcular la media
media <- round(mean(datos), 2)
# Calcular la mediana
mediana <- median(datos)
# Calcular la moda
moda <- as.numeric(names(sort(table(datos), decreasing = TRUE))[1])
# Crear opciones para la media (exactamente 5)
opciones_media <- c(media, media - 2, media + 2, media - 4, media + 4)
opciones_media <- sample(opciones_media)
# Crear opciones para la mediana (exactamente 5)
opciones_mediana <- c(mediana, mediana - 2, mediana + 2, mediana - 4, mediana + 4)
opciones_mediana <- sample(opciones_mediana)
# Crear opciones para la moda (exactamente 5)
opciones_moda <- c(moda, moda - 2, moda + 2, moda - 4, moda + 4)
opciones_moda <- sample(opciones_moda)
# Crear vectores de solución (formato 0/1)
sol_media <- as.numeric(opciones_media == media)
sol_mediana <- as.numeric(opciones_mediana == mediana)
sol_moda <- as.numeric(opciones_moda == moda)
answerlist(opciones_media)
answerlist(opciones_mediana)
answerlist(opciones_moda)
answerlist(ifelse(opciones_media == media, "Correcto", "Incorrecto"))
answerlist(ifelse(opciones_mediana == mediana, "Correcto", "Incorrecto"))
answerlist(ifelse(opciones_moda == moda, "Correcto", "Incorrecto"))
