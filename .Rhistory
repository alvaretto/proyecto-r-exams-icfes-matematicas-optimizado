setwd("~/Insync/alvaroangelm@iepedacitodecielo.edu.co/Google Drive/RepositorioMatematicasICFES_R_Exams/Lab/01-MeMedModa")
library(exams)
knitr::opts_chunk$set(echo = TRUE)
# Número de datos en el conjunto
n_datos <- sample(10:20, 1)
# Generar datos aleatorios (simulando edades)
datos <- round(rnorm(n_datos, mean = 30, sd = 5))
# Calcular la media con 2 decimales
media <- formatC(round(mean(datos), 2), format = "f", digits = 2)
# Calcular la mediana (entero)
mediana <- median(datos)
# Calcular la moda (entero)
moda <- as.numeric(names(sort(table(datos), decreasing = TRUE))[1])
# Crear opciones para la media (2 decimales)
opciones_media <- round(rnorm(4, mean = as.numeric(media), sd = 2), 2)
opciones_media <- c(as.numeric(media), opciones_media)
opciones_media <- unique(opciones_media)
# Asegurar 5 opciones
while(length(opciones_media) < 5) {
new_option <- round(rnorm(1, mean = as.numeric(media), sd = 2), 2)
if(!new_option %in% opciones_media) opciones_media <- c(opciones_media, new_option)
}
opciones_media <- opciones_media[1:5]
opciones_media <- sample(formatC(opciones_media, format = "f", digits = 2)) # Formato consistente
# Crear opciones para la mediana (enteros)
opciones_mediana <- sample(mediana + c(-5:5), 4) # Ajuste para enteros
opciones_mediana <- c(mediana, opciones_mediana)
opciones_mediana <- unique(opciones_mediana)
# Asegurar 5 opciones
while(length(opciones_mediana) < 5) {
new_option <- sample(mediana + c(-10:10), 1)
if(!new_option %in% opciones_mediana) opciones_mediana <- c(opciones_mediana, new_option)
}
opciones_mediana <- opciones_mediana[1:5]
opciones_mediana <- sample(formatC(opciones_mediana, format = "d")) # Formato entero
# Crear opciones para la moda (enteros)
opciones_moda <- sample(moda + c(-5:5), 4) # Ajuste para enteros
opciones_moda <- c(moda, opciones_moda)
opciones_moda <- unique(opciones_moda)
# Asegurar 5 opciones
while(length(opciones_moda) < 5) {
new_option <- sample(moda + c(-10:10), 1)
if(!new_option %in% opciones_moda) opciones_moda <- c(opciones_moda, new_option)
}
opciones_moda <- opciones_moda[1:5]
opciones_moda <- sample(formatC(opciones_moda, format = "d")) # Formato entero
# Vectores de solución
sol_media_vec <- as.numeric(opciones_media == media)
sol_mediana_vec <- as.numeric(opciones_mediana == formatC(mediana, format = "d"))
sol_moda_vec <- as.numeric(opciones_moda == formatC(moda, format = "d"))
answerlist(opciones_media, markup = "markdown")
answerlist(opciones_mediana, markup = "markdown")
answerlist(opciones_moda, markup = "markdown")
source("~/Insync/alvaroangelm@iepedacitodecielo.edu.co/Google Drive/RepositorioMatematicasICFES_R_Exams/Lab/01-MeMedModa/SemilleroUnico2.R")
source("~/Insync/alvaroangelm@iepedacitodecielo.edu.co/Google Drive/RepositorioMatematicasICFES_R_Exams/Lab/01-MeMedModa/SemilleroUnico2.R")
library(exams)
knitr::opts_chunk$set(echo = FALSE)
# Número de datos en el conjunto
n_datos <- sample(10:20, 1)
# Generar datos aleatorios (simulando edades)
datos <- round(rnorm(n_datos, mean = 30, sd = 5))
# Calcular la media
media <- round(mean(datos), 2)
# Calcular la mediana
mediana <- median(datos)
# Calcular la moda
moda <- as.numeric(names(sort(table(datos), decreasing = TRUE))[1])
# Opciones para media
opciones_media <- c(
media,
media - 2.5,
media + 2.5,
media - 5,
media + 5
)
opciones_media <- round(opciones_media, 2)
opciones_media <- sample(opciones_media)
# Opciones para mediana
opciones_mediana <- c(
mediana,
mediana - 2,
mediana + 2,
mediana - 4,
mediana + 4
)
opciones_mediana <- sample(opciones_mediana)
# Opciones para moda
opciones_moda <- c(
moda,
moda - 2,
moda + 2,
moda - 4,
moda + 4
)
opciones_moda <- sample(opciones_moda)
# Soluciones
sol_media <- which(opciones_media == media)
sol_mediana <- which(opciones_mediana == mediana)
sol_moda <- which(opciones_moda == moda)
# Vectores de solución para formato cloze
string_media <- rep("0", 5)
string_media[sol_media] <- "1"
sol_media_string <- paste(string_media, collapse="")
string_mediana <- rep("0", 5)
string_mediana[sol_mediana] <- "1"
sol_mediana_string <- paste(string_mediana, collapse="")
string_moda <- rep("0", 5)
string_moda[sol_moda] <- "1"
sol_moda_string <- paste(string_moda, collapse="")
answerlist(opciones_media)
answerlist(opciones_mediana)
answerlist(opciones_moda)
answerlist(ifelse(opciones_media == media, "Correcto", "Incorrecto"))
answerlist(ifelse(opciones_mediana == mediana, "Correcto", "Incorrecto"))
answerlist(ifelse(opciones_moda == moda, "Correcto", "Incorrecto"))
