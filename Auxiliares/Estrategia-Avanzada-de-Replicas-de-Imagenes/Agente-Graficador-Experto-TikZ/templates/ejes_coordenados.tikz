% Template para ejes coordenados profesionales
% Compatible con Qtikz/Ktikz

\begin{tikzpicture}[scale=1.2]

% Cuadrícula de fondo (opcional)
\draw[gray!20, thin] (-0.5,-0.5) grid[step=0.5] (5.5,3.8);

% Ejes principales con flechas
\draw[thick, ->] (-0.5,0) -- (5.5,0) node[below right] {$x$};
\draw[thick, ->] (0,-0.5) -- (0,3.8) node[above left] {$y$};

% Marcas en el eje X
\foreach \x in {1,2,3,4,5} {
  \draw (\x,-0.1) -- (\x,0.1);
  \node[below] at (\x,-0.1) {\x};
}

% Marcas en el eje Y
\foreach \y in {1,2,3} {
  \draw (-0.1,\y) -- (0.1,\y);
  \node[left] at (-0.1,\y) {\y};
}

% Origen marcado
\fill[black] (0,0) circle (1.5pt);
\node[below left] at (0,0) {$O$};

% Líneas de referencia punteadas (opcional)
\foreach \x in {1,2,3,4,5}
  \draw[gray!30, dashed, thin] (\x,0) -- (\x,3.8);

\foreach \y in {1,2,3}
  \draw[gray!30, dashed, thin] (0,\y) -- (5.5,\y);

% Etiquetas de los ejes
\node[below] at (2.75,-0.4) {Eje X};
\node[left, rotate=90] at (-0.4,1.9) {Eje Y};

\end{tikzpicture}
