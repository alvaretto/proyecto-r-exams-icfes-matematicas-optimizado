% Template para figuras geométricas
% Basado en ejemplos de Fausto y mejores prácticas

\usetikzlibrary{calc, angles, quotes}

\begin{tikzpicture}[scale=1.2]

% Triángulo principal
\coordinate (A) at (0,0);
\coordinate (B) at (4,0);
\coordinate (C) at (2,3);

% Dibujar triángulo con relleno
\draw[blue, thick, fill=blue!20] (A) -- (B) -- (C) -- cycle;

% Marcar vértices
\fill[black] (A) circle (2pt) node[below left] {$A$};
\fill[black] (B) circle (2pt) node[below right] {$B$};
\fill[black] (C) circle (2pt) node[above] {$C$};

% Medidas de lados
\draw[|<->|] ($(A) + (0,-0.3)$) -- ($(B) + (0,-0.3)$) node[midway, below] {$4$ cm};
\draw[|<->|] ($(A) + (-0.3,0)$) -- ($(C) + (-0.3,0.5)$) node[midway, left] {$3.6$ cm};
\draw[|<->|] ($(B) + (0.3,0)$) -- ($(C) + (0.3,0.5)$) node[midway, right] {$3.6$ cm};

% Altura
\draw[dashed, red] (C) -- (2,0) node[below] {$H$};
\draw[|<->|, red] ($(2,0) + (0.2,0)$) -- ($(C) + (0.2,0)$) node[midway, right] {$h = 3$ cm};

% Ángulos
\pic[draw, angle radius=0.5cm, angle eccentricity=1.3, "$\alpha$"] {angle=B--A--C};
\pic[draw, angle radius=0.5cm, angle eccentricity=1.3, "$\beta$"] {angle=C--B--A};
\pic[draw, angle radius=0.5cm, angle eccentricity=1.3, "$\gamma$"] {angle=A--C--B};

% Ángulo recto en la altura
\draw[red] (1.8,0) rectangle (2.2,0.2);

\end{tikzpicture}
