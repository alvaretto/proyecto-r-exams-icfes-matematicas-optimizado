% Template para diagramas y esquemas
% Basado en mejores prácticas de TikZ

\usetikzlibrary{arrows.meta, positioning, shapes.geometric}

\begin{tikzpicture}[
  scale=1.2,
  node distance=2cm,
  thick,
  main node/.style={circle, draw, font=\sffamily\Large\bfseries},
  process/.style={rectangle, draw, fill=blue!20, text width=2cm, text centered},
  decision/.style={diamond, draw, fill=yellow!20, text width=1.5cm, text centered},
  arrow/.style={-{Stealth[length=3mm]}}
]

% Nodos principales
\node[main node] (start) {Inicio};
\node[process, below of=start] (process1) {Proceso 1};
\node[decision, below of=process1] (decision1) {¿Condición?};
\node[process, below left of=decision1] (process2) {Proceso 2A};
\node[process, below right of=decision1] (process3) {Proceso 2B};
\node[main node, below of=decision1, yshift=-2cm] (end) {Fin};

% Conexiones con flechas
\draw[arrow] (start) -- (process1);
\draw[arrow] (process1) -- (decision1);
\draw[arrow] (decision1) -- (process2) node[midway, left] {Sí};
\draw[arrow] (decision1) -- (process3) node[midway, right] {No};
\draw[arrow] (process2) -- (end);
\draw[arrow] (process3) -- (end);

% Etiquetas adicionales
\node[above=0.5cm of start, font=\large\bfseries] {Diagrama de Flujo};

% Marco opcional
\draw[dashed, gray] (-3,-5.5) rectangle (3,1.5);

\end{tikzpicture}
