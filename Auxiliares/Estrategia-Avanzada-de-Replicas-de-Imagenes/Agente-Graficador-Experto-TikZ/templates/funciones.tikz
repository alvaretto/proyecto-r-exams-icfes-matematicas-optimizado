% Template para gráficas de funciones matemáticas
% Basado en ejemplos profesionales y mejores prácticas

\begin{tikzpicture}[scale=1.2]

% Cuadrícula de fondo sutil
\draw[gray!20, thin] (0,0) grid[step=0.5] (5.5,3.8);

% Ejes principales con flechas
\draw[thick, ->] (0,0) -- (5.5,0) node[below right] {$x$};
\draw[thick, ->] (0,0) -- (0,3.8) node[above left] {$y$};

% Función principal (ejemplo: parábola)
\draw[blue, very thick] plot[domain=0:5, samples=100] (\x, {0.2*(\x-2.5)^2 + 1});

% Puntos importantes marcados
\fill[blue] (2.5,1) circle (3pt);
\node[below] at (2.5,1) {Vértice};

% Líneas de referencia punteadas
\draw[black, dashed, thick] (2.5,0) -- (2.5,1);
\draw[black, dashed, thick] (0,1) -- (2.5,1);

% Etiquetas de valores
\node[left] at (0,1) {$1$};
\node[below] at (2.5,0) {$2.5$};

% Marcas en los ejes
\foreach \x in {1,2,3,4,5}
  \draw (\x,-0.1) -- (\x,0.1) node[below] {\x};

\foreach \y in {1,2,3}
  \draw (-0.1,\y) -- (0.1,\y) node[left] {\y};

% Origen
\fill[black] (0,0) circle (1.5pt);

\end{tikzpicture}
