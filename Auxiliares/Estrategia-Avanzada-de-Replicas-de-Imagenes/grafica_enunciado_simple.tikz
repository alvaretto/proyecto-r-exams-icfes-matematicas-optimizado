% GRÁFICA DEL ENUNCIADO - Versión Simple para Qtikz/Ktikz
% Diagrama geométrico principal del problema

\begin{tikzpicture}[scale=1.0]

% Título
\node[above] at (2,3) {\textbf{Gráfica del Enunciado}};

% Segmento QT horizontal
\draw[thick] (0,0) -- (4,0);

% Puntos principales
\fill[black] (0,0) circle (3pt) node[below] {$Q$};
\fill[black] (4,0) circle (3pt) node[below] {$T$};
\fill[blue] (2,0) circle (3pt) node[below] {$K$};

% Punto P arriba
\fill[black] (3,2) circle (3pt) node[above] {$P$};

% Línea KP (distancia que varía)
\draw[blue, thick] (2,0) -- (3,2);

% Línea vertical de referencia (altura h)
\draw[gray, dashed] (3,0) -- (3,2);

% Ángulo α
\draw[red] (0.4,0) arc (0:33.69:0.4);
\node[red] at (0.7,0.15) {$\alpha$};

% Medida h (altura)
\draw[<->] (3.3,0) -- (3.3,2);
\node[right] at (3.4,1) {$h$};

% Etiqueta de distancia KP
\node[blue, above, sloped] at (2.5,1) {$KP$};

% Relación trigonométrica
\node[above] at (2,2.5) {$\sin(\alpha) = \frac{h}{KP}$};

% Indicación del movimiento
\draw[blue, <->] (0.5,0.4) -- (3.5,0.4);
\node[blue, above] at (2,0.6) {$K$ se mueve sobre $QT$};

\end{tikzpicture}
