% OPCIÓN A - Réplica Exacta (Protocolo Mejorado Aplicado)
% Gráfica: Distancia PK vs Ángulo α - Línea horizontal constante
\begin{tikzpicture}[scale=1.0]

% Ejes principales con flechas
\draw[thick, ->] (0,0) -- (5,0) node[below right] {Ángulo $\alpha$};
\draw[thick, ->] (0,0) -- (0,3.5) node[above left] {Distancia PK};

% Línea horizontal constante cyan (característica principal de opción A)
\draw[cyan, very thick] (0.3,2.2) -- (4.7,2.2);

% Marca vertical "h" con línea de referencia
\draw[thick] (1.5,0) -- (1.5,2.2);
\node[right] at (1.6,1.1) {$h$};

% Líneas de cuadrícula sutiles (opcional para mayor precisión)
\draw[gray!30, thin] (0,2.2) -- (5,2.2);

% Origen marcado
\fill[black] (0,0) circle (1pt);

\end{tikzpicture}
