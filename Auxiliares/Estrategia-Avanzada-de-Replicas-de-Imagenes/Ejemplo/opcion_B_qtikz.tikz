% OPCIÓN B - Réplica Exacta (Protocolo Mejorado Aplicado)
% Gráfica: Distancia PK vs Ángulo α - Curva exponencial decreciente
\begin{tikzpicture}[scale=1.0]

% Ejes principales con flechas
\draw[thick, ->] (0,0) -- (5,0) node[below right] {Ángulo $\alpha$};
\draw[thick, ->] (0,0) -- (0,3.5);

% Etiqueta del eje Y alejada y movida hacia abajo
\node[above, rotate=90] at (-0.5,1.0) {Distancia PK};

% Curva exponencial decreciente cyan (característica principal de opción B)
% Función tipo: f(α) = QP * e^(-k*α) + h
\draw[cyan, very thick] (0.8,2.8) .. controls (1.5,2.4) and (2.5,1.8) .. (4.2,1.4);

% Puntos importantes marcados en cyan
\fill[cyan] (0.8,2.8) circle (3pt);
\fill[cyan] (4.2,1.4) circle (3pt);

% Líneas punteadas de referencia
\draw[black, dashed] (0.8,0) -- (0.8,2.8);
\draw[black, dashed] (4.2,0) -- (4.2,1.4);
\draw[black, dashed] (0,1.4) -- (4.2,1.4);

% Etiquetas específicas
\node[left] at (-0.1,2.8) {$QP$};
\node[left] at (-0.1,1.4) {$h$};

% Origen marcado
\fill[black] (0,0) circle (1pt);

\end{tikzpicture}
