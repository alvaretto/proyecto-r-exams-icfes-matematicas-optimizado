}
# Completar documento LaTeX
full_tex <- paste0(
preamble,
"\\pagestyle{empty}\n",
"\\begin{document}\n",
tikz_code,
"\n\\end{document}"
)
# Escribir archivo TEX
writeLines(full_tex, tikz_file)
# Compilar a PDF
wd_orig <- getwd()
setwd(tikz_dir)
system2("pdflatex", c("-interaction=nonstopmode", basename(tikz_file)))
# Generar PNG desde PDF
pdf_file <- sub("\\.tex$", ".pdf", basename(tikz_file))
png_file <- sub("\\.tex$", ".png", basename(tikz_file))
# Usar convert para crear PNG
system2("convert", c("-density", "300", pdf_file, "-quality", "100", png_file))
# Volver al directorio original
setwd(wd_orig)
# Ruta completa al archivo PNG
png_path <- file.path(tikz_dir, png_file)
# Devolver código para incluir la imagen según el formato
if (markup == "markdown") {
return(paste0("![](", png_path, ")"))
} else {
return(paste0("\\includegraphics[width=", width, "]{", png_path, "}"))
}
}, silent = TRUE)
# Si algo falló, usamos el método alternativo
warning("Hubo un problema al generar la tabla con TikZ. Usando método alternativo.")
return(crear_tabla_html(tikz_code))
}
# Función para crear una tabla HTML a partir del código TikZ (método alternativo)
crear_tabla_html <- function(tikz_code) {
# Extraer contenido de la tabla
tabla_pattern <- "\\\\begin\\{tabular\\}\\{.*?\\}(.*?)\\\\end\\{tabular\\}"
tabla_match <- regexpr(tabla_pattern, tikz_code, perl = TRUE)
if (tabla_match != -1) {
tabla_contenido <- regmatches(tikz_code, tabla_match)
# Limpiar marcado TikZ y convertir a HTML
tabla_contenido <- gsub("\\\\begin\\{tabular\\}\\{.*?\\}", "<table border='1' cellpadding='5'>", tabla_contenido)
tabla_contenido <- gsub("\\\\end\\{tabular\\}", "</table>", tabla_contenido)
tabla_contenido <- gsub("\\\\hline", "", tabla_contenido)
tabla_contenido <- gsub(" & ", "</td><td>", tabla_contenido)
tabla_contenido <- gsub(" \\\\\\\\", "</td></tr><tr><td>", tabla_contenido)
# Asegurar que comienza con <tr><td> y termina con </td></tr>
if (!grepl("^<tr>", tabla_contenido)) {
tabla_contenido <- paste0("<tr><td>", tabla_contenido)
}
if (!grepl("</tr>$", tabla_contenido)) {
tabla_contenido <- paste0(tabla_contenido, "</td></tr>")
}
return(tabla_contenido)
} else {
# Si no podemos extraer la tabla, devolvemos el código original como texto pre-formateado
return(paste0("<pre>", tikz_code, "</pre>"))
}
}
