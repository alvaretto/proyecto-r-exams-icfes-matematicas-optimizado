for (attempt in 1:max_attempts) {
data <- list(
n_total = sample(RANGES$total[1]:RANGES$total[2], 1),
n_A = sample(RANGES$single[1]:RANGES$single[2], 1),
n_B = sample(RANGES$single[1]:RANGES$single[2], 1),
n_C = sample(RANGES$C[1]:RANGES$C[2], 1)
)
data$n_AB <- sample(RANGES$double[1]:RANGES$double[2], 1)
data$n_AC <- sample(RANGES$AC[1]:RANGES$AC[2], 1)
data$n_BC <- sample(RANGES$double[1]:RANGES$double[2], 1)
data$n_all <- sample(RANGES$all[1]:RANGES$all[2], 1)
if (validate_data(data)) {
# Calcular valores derivados
data$n_only_A <- data$n_A - data$n_AB - data$n_AC + data$n_all
data$n_only_B <- data$n_B - data$n_AB - data$n_BC + data$n_all
data$n_only_C <- data$n_C - data$n_AC - data$n_BC + data$n_all
data$n_AB_only <- data$n_AB - data$n_all
data$n_AC_only <- data$n_AC - data$n_all
data$n_BC_only <- data$n_BC - data$n_all
data$n_none <- data$n_total - (data$n_A + data$n_B + data$n_C -
data$n_AB - data$n_AC - data$n_BC + data$n_all)
return(data)
}
}
stop("No se pudieron generar datos válidos después de ", max_attempts, " intentos")
}
# Función para generar géneros musicales
generate_random_genres <- function() {
genres <- c("Vallenato", "Salsa", "Merengue", "Reggaeton", "Bachata",
"Cumbia", "Rap", "Electrónica", "Tango", "Gospel")
sample(genres, 3)
}
# Función para generar texto descriptivo
generate_random_text <- function(data, A, B, C) {
template <- paste(
"Se ha entrevistado a %d adolescentes sobre los géneros musicales que escuchan.\n\n",
"- %d de ellos escuchan %s, \n",
"- %d escuchan %s, y \n",
"- %d %s. \n\n",
"Además sabemos que \n\n",
"- %d de ellos escuchan %s y %s,\n",
"- %d escuchan %s y %s, y\n",
"- %d %s y %s."
)
sprintf(template,
data$n_total,
data$n_A, A,
data$n_B, B,
data$n_C, C,
data$n_AB, A, B,
data$n_AC, A, C,
data$n_BC, B, C)
}
# Configuración específica para formatos de salida
format_specific_settings <- list(
pdf = list(
fig_width = 6,
fig_height = 6,
tikz_options = "scale=0.7"
),
html = list(
fig_width = 8,
fig_height = 8,
tikz_options = "scale=0.9"
),
moodle = list(
fig_width = 7,
fig_height = 7,
tikz_options = "scale=0.8"
)
)
# Función para crear el diagrama de Venn
create_venn_diagram <- function(data, A, B, C, format = "pdf") {
settings <- format_specific_settings[[format]]
sprintf('
\\begin{tikzpicture}[%s]
\\begin{scope}[opacity=0.5]
\\fill[red!60]   ( 90:1.5) circle (2);
\\fill[green!60] (210:1.5) circle (2);
\\fill[blue!60]  (330:1.5) circle (2);
\\end{scope}
\\node at ( 90:3.3) {%s};
\\node at (210:3.3) {%s};
\\node at (330:3.3) {%s};
\\node at ( 90:1.3) {%d};
\\node at (210:1.3) {%d};
\\node at (330:1.3) {%d};
\\node at ( 30:1.7) {%d};
\\node at (150:1.7) {%d};
\\node at (270:1.7) {%d};
\\node at (0:0) {%d};
\\node at (270:3.5) {Ninguno: %d};
\\end{tikzpicture}',
settings$tikz_options,
A, B, C,
data$n_only_A, data$n_only_B, data$n_only_C,
data$n_AC_only, data$n_AB_only, data$n_BC_only,
data$n_all, data$n_none
)
}
# Generar datos y preparar el ejercicio
tryCatch({
# Generar datos
data <- generate_valid_data()
# Generar géneros musicales
genres <- generate_random_genres()
A <- genres[1]
B <- genres[2]
C <- genres[3]
# Generar texto del problema
random_text <- generate_random_text(data, A, B, C)
# Definir preguntas y respuestas
questions <- c(
sprintf("¿Cuántas personas escuchan solamente %s y %s?", A, B),
sprintf("¿Cuántos adolescentes disfrutan únicamente de %s y %s?", A, C),
sprintf("¿Cuál es el número de entrevistados que solo escuchan %s y %s?", B, C),
"¿Cuántas personas escuchan los tres géneros musicales?",
"¿Cuántos adolescentes no escuchan ninguno de estos géneros musicales?",
sprintf("¿Cuántas personas escuchan %s pero no %s?", A, B),
sprintf("¿Cuántos jóvenes escuchan %s o %s, o ambos?", A, C),
"¿Cuántos adolescentes escuchan al menos uno de estos géneros musicales?"
)
answers <- c(
data$n_AB_only,
data$n_AC_only,
data$n_BC_only,
data$n_all,
data$n_none,
data$n_only_A + data$n_AC_only,
data$n_A + data$n_C - data$n_AC,
data$n_total - data$n_none
)
# Seleccionar preguntas aleatorias
selected_indices <- sample(length(questions), 4)
selected_questions <- questions[selected_indices]
selected_answers <- answers[selected_indices]
# Crear el diagrama de Venn
tikz_venn <- create_venn_diagram(data, A, B, C)
}, error = function(e) {
message("Error en la generación del ejercicio: ", e$message)
stop(e)
})
# Configuración final de knitr
knitr::opts_chunk$set(warning = FALSE, message = FALSE)
Función para incluir el diagrama TikZ
# Configuración inicial
knitr::opts_chunk$set(echo = FALSE, warning = FALSE, message = FALSE)
# Cargar librerías necesarias
library(exams)
library(knitr)
# Definir rangos como constantes globales
RANGES <- list(
total = c(30, 50),
single = c(15, 25),
C = c(20, 30),
double = c(3, 8),
AC = c(5, 10),
all = c(2, 5)
)
# Función para validar datos
validate_data <- function(data) {
with(data, {
values <- c(
n_A - n_AB - n_AC + n_all,  # only_A
n_B - n_AB - n_BC + n_all,  # only_B
n_C - n_AC - n_BC + n_all,  # only_C
n_AB - n_all,               # AB_only
n_AC - n_all,               # AC_only
n_BC - n_all                # BC_only
)
all(values >= 0)
})
}
# Función mejorada para generar datos válidos
generate_valid_data <- function(max_attempts = 1000) {
for (attempt in 1:max_attempts) {
data <- list(
n_total = sample(RANGES$total[1]:RANGES$total[2], 1),
n_A = sample(RANGES$single[1]:RANGES$single[2], 1),
n_B = sample(RANGES$single[1]:RANGES$single[2], 1),
n_C = sample(RANGES$C[1]:RANGES$C[2], 1)
)
data$n_AB <- sample(RANGES$double[1]:RANGES$double[2], 1)
data$n_AC <- sample(RANGES$AC[1]:RANGES$AC[2], 1)
data$n_BC <- sample(RANGES$double[1]:RANGES$double[2], 1)
data$n_all <- sample(RANGES$all[1]:RANGES$all[2], 1)
if (validate_data(data)) {
# Calcular valores derivados
data$n_only_A <- data$n_A - data$n_AB - data$n_AC + data$n_all
data$n_only_B <- data$n_B - data$n_AB - data$n_BC + data$n_all
data$n_only_C <- data$n_C - data$n_AC - data$n_BC + data$n_all
data$n_AB_only <- data$n_AB - data$n_all
data$n_AC_only <- data$n_AC - data$n_all
data$n_BC_only <- data$n_BC - data$n_all
data$n_none <- data$n_total - (data$n_A + data$n_B + data$n_C -
data$n_AB - data$n_AC - data$n_BC + data$n_all)
return(data)
}
}
stop("No se pudieron generar datos válidos después de ", max_attempts, " intentos")
}
