# Función para generar datos con características controladas
generar_datos_controlados <- function(n, tipo, rango_min, rango_max) {
if (tipo == "simetrica") {
media <- (rango_min + rango_max) / 2
desviacion <- (rango_max - rango_min) / 6
datos <- rnorm(n, mean = media, sd = desviacion)
} else if (tipo == "asimetrica_positiva") {
datos <- rbeta(n, 2, 5) * (rango_max - rango_min) + rango_min
} else if (tipo == "asimetrica_negativa") {
datos <- rbeta(n, 5, 2) * (rango_max - rango_min) + rango_min
}
# Asegurar que los datos estén en el rango y redondear apropiadamente
datos <- pmax(rango_min, pmin(rango_max, datos))
if (contexto_seleccionado$tipo %in% c("calificaciones", "edades", "tiempos")) {
return(round(datos))
} else {
return(round(datos, 1))
}
}
# Generar los datos principales
datos_principales <- generar_datos_controlados(
tamaño_muestra,
tipo_distribucion,
rango_seleccionado[1],
rango_seleccionado[2]
)
# Calcular estadísticas descriptivas
calcular_estadisticas <- function(datos) {
list(
minimo = unname(as.numeric(min(datos))),
q1 = unname(as.numeric(quantile(datos, 0.25))),
mediana = unname(as.numeric(median(datos))),
q3 = unname(as.numeric(quantile(datos, 0.75))),
maximo = unname(as.numeric(max(datos)))
)
}
stats_correctas <- calcular_estadisticas(datos_principales)
# Generar tres conjuntos de estadísticas para distractores
generar_distractores <- function(stats_base) {
rango_total <- rango_seleccionado[2] - rango_seleccionado[1]
# Distractor 1: Mediana desplazada
distractor1 <- stats_base
desplazamiento <- sample(c(-1, 1), 1) * runif(1, 0.1, 0.2) * rango_total
distractor1$mediana <- max(rango_seleccionado[1],
min(rango_seleccionado[2],
stats_base$mediana + desplazamiento))
# Distractor 2: Cuartiles incorrectos
distractor2 <- stats_base
factor_q1 <- runif(1, 0.8, 1.2)
factor_q3 <- runif(1, 0.8, 1.2)
distractor2$q1 <- max(rango_seleccionado[1],
min(stats_base$mediana - 1, stats_base$q1 * factor_q1))
distractor2$q3 <- min(rango_seleccionado[2],
max(stats_base$mediana + 1, stats_base$q3 * factor_q3))
# Distractor 3: Rango incorrecto
distractor3 <- stats_base
factor_rango <- runif(1, 0.7, 1.3)
centro <- (stats_base$minimo + stats_base$maximo) / 2
nuevo_rango <- (stats_base$maximo - stats_base$minimo) * factor_rango
distractor3$minimo <- max(rango_seleccionado[1], centro - nuevo_rango/2)
distractor3$maximo <- min(rango_seleccionado[2], centro + nuevo_rango/2)
return(list(distractor1, distractor2, distractor3))
}
distractores <- generar_distractores(stats_correctas)
