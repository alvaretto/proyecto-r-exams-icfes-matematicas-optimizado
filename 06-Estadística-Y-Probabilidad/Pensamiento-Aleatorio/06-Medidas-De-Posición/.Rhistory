return(FALSE)
}
return(TRUE)
}
# Generar datos y calcular estadísticos
set.seed(sample(1:1000, 1))
datos <- generar_estaturas()
stats <- calcular_estadisticos(datos)
# Crear diagramas (1 correcto y 3 incorrectos)
diagramas <- list()
diagramas[[1]] <- crear_diagrama(stats, "correcto")
for (i in 2:4) {
diagramas[[i]] <- crear_diagrama(stats, "incorrecto")
# Asegurar que los diagramas incorrectos sean suficientemente diferentes entre sí y del correcto
intentos <- 0
while ((son_diagramas_similares(diagramas[[i]], diagramas[[1]]) ||
(i > 2 && son_diagramas_similares(diagramas[[i]], diagramas[[2]])) ||
(i > 3 && son_diagramas_similares(diagramas[[i]], diagramas[[3]]))) &&
intentos < 10) {
diagramas[[i]] <- crear_diagrama(stats, "incorrecto")
intentos <- intentos + 1
}
# Si después de varios intentos sigue siendo similar, forzar diferencias más grandes
if (intentos >= 10) {
j <- i - 1
diagramas[[i]]$q1 <- redondear_cuartil(diagramas[[1]]$q1 * (1 + j*0.05))
diagramas[[i]]$q3 <- redondear_cuartil(diagramas[[1]]$q3 * (1 - j*0.05))
diagramas[[i]]$mediana <- redondear_cuartil(diagramas[[1]]$mediana * (1 + j*0.07))
}
}
# Verificar que ningún diagrama tenga valores nulos
for (i in 1:4) {
if (is.null(diagramas[[i]]$minimo) || is.null(diagramas[[i]]$maximo) ||
is.null(diagramas[[i]]$q1) || is.null(diagramas[[i]]$q3) || is.null(diagramas[[i]]$mediana)) {
# Si hay valores nulos, regenerar el diagrama
diagramas[[i]] <- crear_diagrama(stats, ifelse(i == 1, "correcto", "incorrecto"))
}
}
# Calcular el rango global para todos los diagramas
min_global <- min(sapply(diagramas, function(d) d$minimo))
max_global <- max(sapply(diagramas, function(d) d$maximo))
rango_global <- max_global - min_global
# Determinar la posición correcta (1 a 4) para la respuesta
solucion <- sample(1:4, 1)
# Reordenar los diagramas para que el correcto esté en la posición de la solución
if (solucion != 1) {
temp <- diagramas[[1]]
diagramas[[1]] <- diagramas[[solucion]]
diagramas[[solucion]] <- temp
}
# Verificar que todos los diagramas son diferentes entre sí
for (i in 1:3) {
for (j in (i+1):4) {
if (!son_diagramas_diferentes(diagramas[[i]], diagramas[[j]])) {
# Si hay diagramas idénticos, modificar uno de ellos ligeramente
diagramas[[j]]$q1 <- redondear_cuartil(diagramas[[j]]$q1 * (1 + j*0.01))
diagramas[[j]]$q3 <- redondear_cuartil(diagramas[[j]]$q3 * (1 - j*0.01))
}
}
}
# Crear una tabla con los datos desordenados para mostrar en el enunciado
tabla_datos <- data.frame(Estatura = stats$datos_desordenados)
# Corregir el problema con align en xtable
tabla_xtable <- xtable(tabla_datos,
caption = "Estaturas de estudiantes (cm)",
align = c("c", "c"))  # Un valor para la columna de índice y otro para la columna de datos
print(tabla_xtable, type = "html", include.rownames = FALSE)
# Configurar el área de dibujo con 2 filas y 2 columnas
par(mfrow = c(2, 2), mar = c(4, 4, 3, 2))
# Calcular límites globales para todos los diagramas con margen adicional para evitar solapamiento
y_min_global <- min_global - rango_global * 0.2
y_max_global <- max_global + rango_global * 0.2
# Dibujar cada diagrama con los mismos límites
for (i in 1:4) {
# Crear un nuevo gráfico para cada diagrama
plot(NA, xlim = c(0.5, 1.5), ylim = c(y_min_global, y_max_global),
xlab = "", ylab = "Estatura (cm)",
main = paste("Diagrama", LETTERS[i]), axes = FALSE)
# Añadir ejes y etiquetas
axis(2, las = 1)  # Eje Y con etiquetas horizontales
# Dibujar el diagrama
dibujar_diagrama(diagramas[[i]])
# Añadir etiquetas de valores sin solapamiento
text(1.4, diagramas[[i]]$minimo, diagramas[[i]]$minimo, pos = 4, cex = 0.8)
text(1.4, diagramas[[i]]$q1, diagramas[[i]]$q1, pos = 4, cex = 0.8)
text(1.4, diagramas[[i]]$mediana, diagramas[[i]]$mediana, pos = 4, cex = 0.8)
text(1.4, diagramas[[i]]$q3, diagramas[[i]]$q3, pos = 4, cex = 0.8)
text(1.4, diagramas[[i]]$maximo, diagramas[[i]]$maximo, pos = 4, cex = 0.8)
}
library(exams)
library(xtable)
# Función para redondear cuartiles según las reglas especificadas
redondear_cuartil <- function(valor) {
valor_redondeado <- round(valor, 1)
if (valor_redondeado %% 1 == 0) {
return(as.integer(valor_redondeado))
} else {
return(valor_redondeado)
}
}
# Función para generar datos de estaturas
generar_estaturas <- function(n = sample(20:30, 1), min = 150, max = 190) {
# Generar estaturas aleatorias con distribución normal
estaturas <- round(rnorm(n, mean = (min + max) / 2, sd = (max - min) / 4))
# Asegurar que estén dentro del rango deseado
estaturas <- pmax(min, pmin(max, estaturas))
return(estaturas)
}
# Función para calcular estadísticos usando método de Tukey
calcular_estadisticos <- function(datos) {
datos_ordenados <- sort(datos)
n <- length(datos)
# Calcular cuartiles usando método de Tukey (mismo que boxplot de R)
q1 <- quantile(datos, 0.25, type = 7)
q2 <- quantile(datos, 0.50, type = 7)
q3 <- quantile(datos, 0.75, type = 7)
return(list(
datos_ordenados = datos_ordenados,
datos_desordenados = sample(datos),
minimo = min(datos),
q1 = redondear_cuartil(q1),
mediana = redondear_cuartil(q2),
q3 = redondear_cuartil(q3),
maximo = max(datos)
))
}
# Función para crear un diagrama de caja
crear_diagrama <- function(stats, tipo = "correcto") {
if (tipo == "correcto") {
return(list(
minimo = stats$minimo,
q1 = stats$q1,
mediana = stats$mediana,
q3 = stats$q3,
maximo = stats$maximo
))
} else {
# Para diagramas incorrectos, modificar algunos valores
modificador_q1 <- runif(1, 0.92, 1.08)
modificador_mediana <- runif(1, 0.95, 1.05)
modificador_q3 <- runif(1, 0.92, 1.08)
return(list(
minimo = stats$minimo,
q1 = redondear_cuartil(stats$q1 * modificador_q1),
mediana = redondear_cuartil(stats$mediana * modificador_mediana),
q3 = redondear_cuartil(stats$q3 * modificador_q3),
maximo = stats$maximo
))
}
}
# Función para dibujar un diagrama de caja
dibujar_diagrama <- function(diagrama) {
# Calcular el rango para ajustar posiciones
rango <- diagrama$maximo - diagrama$minimo
espacio_min <- rango * 0.05  # 5% del rango como espacio mínimo
# Dibujar la caja
rect(0.75, diagrama$q1, 1.25, diagrama$q3, col = "lightblue")
# Dibujar la mediana
segments(0.75, diagrama$mediana, 1.25, diagrama$mediana, lwd = 2)
# Dibujar los bigotes
segments(1, diagrama$q1, 1, diagrama$minimo, lwd = 1)
segments(0.85, diagrama$minimo, 1.15, diagrama$minimo, lwd = 1)
segments(1, diagrama$q3, 1, diagrama$maximo, lwd = 1)
segments(0.85, diagrama$maximo, 1.15, diagrama$maximo, lwd = 1)
# Añadir etiquetas con posiciones ajustadas para evitar solapamiento
text_offset <- 0.15  # Desplazamiento horizontal para las etiquetas
# Etiquetas para mínimo y máximo (siempre en los extremos)
text(1 + text_offset, diagrama$minimo, diagrama$minimo, pos = 4)
text(1 + text_offset, diagrama$maximo, diagrama$maximo, pos = 4)
# Verificar si hay suficiente espacio entre Q1 y mínimo
if (diagrama$q1 - diagrama$minimo > espacio_min) {
text(1 + text_offset, diagrama$q1, diagrama$q1, pos = 4)
} else {
# Colocar etiqueta Q1 más arriba para evitar solapamiento
text(1 + text_offset, diagrama$minimo + (diagrama$q1 - diagrama$minimo)/2, diagrama$q1, pos = 4)
}
# Verificar si hay suficiente espacio entre mediana y Q1
if (diagrama$mediana - diagrama$q1 > espacio_min) {
text(1 + text_offset, diagrama$mediana, diagrama$mediana, pos = 4)
} else {
# Colocar etiqueta mediana más arriba
text(1 + text_offset, diagrama$q1 + (diagrama$mediana - diagrama$q1)/2, diagrama$mediana, pos = 4)
}
# Verificar si hay suficiente espacio entre Q3 y mediana
if (diagrama$q3 - diagrama$mediana > espacio_min) {
text(1 + text_offset, diagrama$q3, diagrama$q3, pos = 4)
} else {
# Colocar etiqueta Q3 más arriba
text(1 + text_offset, diagrama$mediana + (diagrama$q3 - diagrama$mediana)/2, diagrama$q3, pos = 4)
}
}
# Función para verificar que los diagramas son suficientemente diferentes
son_diagramas_similares <- function(diag1, diag2, umbral = 0.02) {
# Calcular diferencias relativas
dif_q1 <- abs(diag1$q1 - diag2$q1) / max(diag1$q1, diag2$q1)
dif_mediana <- abs(diag1$mediana - diag2$mediana) / max(diag1$mediana, diag2$mediana)
dif_q3 <- abs(diag1$q3 - diag2$q3) / max(diag1$q3, diag2$q3)
# Si todas las diferencias son menores que el umbral, son similares
if (dif_q1 < umbral && dif_mediana < umbral && dif_q3 < umbral) {
return(TRUE)
}
return(FALSE)
}
# Función para verificar que los diagramas son diferentes
son_diagramas_diferentes <- function(diag1, diag2) {
# Comparar valores clave
if (identical(diag1$minimo, diag2$minimo) &&
identical(diag1$q1, diag2$q1) &&
identical(diag1$mediana, diag2$mediana) &&
identical(diag1$q3, diag2$q3) &&
identical(diag1$maximo, diag2$maximo)) {
return(FALSE)
}
return(TRUE)
}
