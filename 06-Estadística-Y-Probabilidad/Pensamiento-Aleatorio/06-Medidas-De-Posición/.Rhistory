source("~/Insync/alvaroangelm@iepedacitodecielo.edu.co/Google Drive/RepositorioMatematicasICFES_R_Exams/06-Estadística-Y-Probabilidad/Pensamiento-Aleatorio/06-Medidas-De-Posición/SemilleroUnico2.R", echo=TRUE)
knitr::opts_chunk$set(echo = FALSE)
library(exams)
library(xtable)
# Función para generar datos de estatura
generar_datos_estatura <- function() {
# Generar número impar de datos entre 7 y 19
n <- sample(seq(7, 19, by = 2), 1)
# Generar datos base
base_min <- 155
base_max <- 172
variacion <- 10
# Generar límites aleatorios
min_valor <- base_min - sample(0:variacion, 1)
max_valor <- base_max + sample(0:variacion, 1)
# Generar datos aleatorios
datos <- round(runif(n, min_valor, max_valor))
# Asegurar que al menos algunos datos estén cerca de los extremos
datos[1] <- min_valor + sample(-2:2, 1)
datos[2] <- max_valor + sample(-2:2, 1)
# Calcular estadísticas
datos_ordenados <- sort(datos)
minimo <- min(datos)
maximo <- max(datos)
mediana <- median(datos)
q1 <- quantile(datos, 0.25)
q3 <- quantile(datos, 0.75)
return(list(
datos_desordenados = datos,
datos_ordenados = datos_ordenados,
minimo = minimo,
q1 = q1,
mediana = mediana,
q3 = q3,
maximo = maximo
))
}
# Función para crear diagramas
crear_diagrama <- function(valores, tipo) {
if(tipo == "correcto") {
boxplot(valores$datos_ordenados,
horizontal = FALSE,
axes = FALSE,
col = "lightblue",
border = "blue",
outline = TRUE,
whisklty = 1,
staplelty = 1,
outpch = 16,
outcol = "blue")
axis(2, las = 1)
box()
# Agregar etiquetas
text(1.3, valores$minimo, paste("Mín =", valores$minimo), pos = 4, cex = 0.8)
text(1.3, valores$q1, paste("Q1 =", valores$q1), pos = 4, cex = 0.8)
text(1.3, valores$mediana, paste("Q2 =", valores$mediana), pos = 4, cex = 0.8)
text(1.3, valores$q3, paste("Q3 =", valores$q3), pos = 4, cex = 0.8)
text(1.3, valores$maximo, paste("Máx =", valores$maximo), pos = 4, cex = 0.8)
} else if(tipo == "escala_10") {
valores_escalados <- list(
datos_ordenados = valores$datos_ordenados * 10,
minimo = valores$minimo * 10,
q1 = valores$q1 * 10,
mediana = valores$mediana * 10,
q3 = valores$q3 * 10,
maximo = valores$maximo * 10
)
boxplot(valores_escalados$datos_ordenados,
horizontal = FALSE,
axes = FALSE,
col = "lightblue",
border = "blue",
outline = TRUE,
whisklty = 1,
staplelty = 1,
outpch = 16,
outcol = "blue")
axis(2, las = 1)
box()
# Agregar etiquetas
text(1.3, valores_escalados$minimo, paste("Mín =", valores_escalados$minimo), pos = 4, cex = 0.8)
text(1.3, valores_escalados$q1, paste("Q1 =", valores_escalados$q1), pos = 4, cex = 0.8)
text(1.3, valores_escalados$mediana, paste("Q2 =", valores_escalados$mediana), pos = 4, cex = 0.8)
text(1.3, valores_escalados$q3, paste("Q3 =", valores_escalados$q3), pos = 4, cex = 0.8)
text(1.3, valores_escalados$maximo, paste("Máx =", valores_escalados$maximo), pos = 4, cex = 0.8)
} else if(tipo == "invertido") {
# Invertir Q1 y Q3
datos_mod <- valores$datos_ordenados
q1_idx <- floor(length(datos_mod) * 0.25)
q3_idx <- ceiling(length(datos_mod) * 0.75)
temp <- datos_mod[q1_idx]
datos_mod[q1_idx] <- datos_mod[q3_idx]
datos_mod[q3_idx] <- temp
valores_invertidos <- list(
datos_ordenados = datos_mod,
minimo = valores$minimo,
q1 = valores$q3,  # Intercambiados
mediana = valores$mediana,
q3 = valores$q1,  # Intercambiados
maximo = valores$maximo
)
boxplot(datos_mod,
horizontal = FALSE,
axes = FALSE,
col = "lightblue",
border = "blue",
outline = TRUE,
whisklty = 1,
staplelty = 1,
outpch = 16,
outcol = "blue")
axis(2, las = 1)
box()
# Agregar etiquetas
text(1.3, valores_invertidos$minimo, paste("Mín =", valores_invertidos$minimo), pos = 4, cex = 0.8)
text(1.3, valores_invertidos$q1, paste("Q1 =", valores_invertidos$q1), pos = 4, cex = 0.8)
text(1.3, valores_invertidos$mediana, paste("Q2 =", valores_invertidos$mediana), pos = 4, cex = 0.8)
text(1.3, valores_invertidos$q3, paste("Q3 =", valores_invertidos$q3), pos = 4, cex = 0.8)
text(1.3, valores_invertidos$maximo, paste("Máx =", valores_invertidos$maximo), pos = 4, cex = 0.8)
} else if(tipo == "mediana_falsa") {
# Modificar la mediana
datos_mod <- valores$datos_ordenados
med_idx <- ceiling(length(datos_mod)/2)
nueva_mediana <- mean(c(valores$minimo, valores$maximo))
datos_mod[med_idx] <- nueva_mediana
valores_mediana_falsa <- list(
datos_ordenados = datos_mod,
minimo = valores$minimo,
q1 = valores$q1,
mediana = nueva_mediana,
q3 = valores$q3,
maximo = valores$maximo
)
boxplot(datos_mod,
horizontal = FALSE,
axes = FALSE,
col = "lightblue",
border = "blue",
outline = TRUE,
whisklty = 1,
staplelty = 1,
outpch = 16,
outcol = "blue")
axis(2, las = 1)
box()
# Agregar etiquetas
text(1.3, valores_mediana_falsa$minimo, paste("Mín =", valores_mediana_falsa$minimo), pos = 4, cex = 0.8)
text(1.3, valores_mediana_falsa$q1, paste("Q1 =", valores_mediana_falsa$q1), pos = 4, cex = 0.8)
text(1.3, valores_mediana_falsa$mediana, paste("Q2 =", valores_mediana_falsa$mediana), pos = 4, cex = 0.8)
text(1.3, valores_mediana_falsa$q3, paste("Q3 =", valores_mediana_falsa$q3), pos = 4, cex = 0.8)
text(1.3, valores_mediana_falsa$maximo, paste("Máx =", valores_mediana_falsa$maximo), pos = 4, cex = 0.8)
}
}
# Genera datos iniciales
stats <- generar_datos_estatura()
# Crea y muestra la tabla
datos_tabla <- data.frame(
"Estudiante" = 1:length(stats$datos_desordenados),
"Estatura (cm)" = stats$datos_desordenados
)
tabla_xtable <- xtable(datos_tabla,
align = c("l", "c", "c"),
digits = c(0, 0, 0))
print(tabla_xtable,
type = "html",
include.rownames = FALSE,
html.table.attributes = 'border="1" cellpadding="5" cellspacing="0"')
# Genera los diagramas como archivos PNG
# Diagrama A (correcto)
png("DiagramaA.png", width = 700, height = 500, res = 100)
par(mar = c(4, 4, 2, 2))
plot(NA, xlim = c(0.5, 1.5),
ylim = c(stats$minimo - (stats$maximo - stats$minimo) * 0.15,
stats$maximo + (stats$maximo - stats$minimo) * 0.15),
xlab = "", ylab = "Estatura (cm)",
main = "", axes = FALSE)
crear_diagrama(stats, "correcto")
dev.off()
# Diagrama B (escala x10)
png("DiagramaB.png", width = 700, height = 500, res = 100)
par(mar = c(4, 4, 2, 2))
plot(NA, xlim = c(0.5, 1.5),
ylim = c(stats$minimo*10 - (stats$maximo*10 - stats$minimo*10) * 0.15,
stats$maximo*10 + (stats$maximo*10 - stats$minimo*10) * 0.15),
xlab = "", ylab = "Estatura (cm)",
main = "", axes = FALSE)
crear_diagrama(stats, "escala_10")
dev.off()
# Diagrama C (cuartiles invertidos)
png("DiagramaC.png", width = 700, height = 500, res = 100)
par(mar = c(4, 4, 2, 2))
plot(NA, xlim = c(0.5, 1.5),
ylim = c(stats$minimo - (stats$maximo - stats$minimo) * 0.15,
stats$maximo + (stats$maximo - stats$minimo) * 0.15),
xlab = "", ylab = "Estatura (cm)",
main = "", axes = FALSE)
crear_diagrama(stats, "invertido")
dev.off()
# Diagrama D (mediana incorrecta)
png("DiagramaD.png", width = 700, height = 500, res = 100)
par(mar = c(4, 4, 2, 2))
plot(NA, xlim = c(0.5, 1.5),
ylim = c(stats$minimo - (stats$maximo - stats$minimo) * 0.15,
stats$maximo + (stats$maximo - stats$minimo) * 0.15),
xlab = "", ylab = "Estatura (cm)",
main = "", axes = FALSE)
crear_diagrama(stats, "mediana_falsa")
dev.off()
