tipo_error_diagramas[i] <- "valores"
}
}
}
# Verificar que todos los diagramas son diferentes entre sí
diagramas_diferentes <- asegurar_diagramas_diferentes(valores_diagramas)
}
library(exams)
library(xtable)
knitr::opts_chunk$set(echo = FALSE, warning = FALSE, message = FALSE)
# Función para calcular cuartiles con método tradicional
calcular_cuartiles_tradicional <- function(datos) {
n <- length(datos)
# Calcular posiciones
pos_q1 <- (n + 1) / 4
pos_q2 <- (n + 1) / 2
pos_q3 <- 3 * (n + 1) / 4
# Calcular valores
q1 <- if(pos_q1 %% 1 == 0) {
datos[pos_q1]
} else {
parte_entera <- floor(pos_q1)
parte_decimal <- pos_q1 - parte_entera
datos[parte_entera] + parte_decimal * (datos[parte_entera + 1] - datos[parte_entera])
}
q2 <- if(pos_q2 %% 1 == 0) {
datos[pos_q2]
} else {
parte_entera <- floor(pos_q2)
parte_decimal <- pos_q2 - parte_entera
datos[parte_entera] + parte_decimal * (datos[parte_entera + 1] - datos[parte_entera])
}
q3 <- if(pos_q3 %% 1 == 0) {
datos[pos_q3]
} else {
parte_entera <- floor(pos_q3)
parte_decimal <- pos_q3 - parte_entera
datos[parte_entera] + parte_decimal * (datos[parte_entera + 1] - datos[parte_entera])
}
return(list(q1 = q1, q2 = q2, q3 = q3))
}
# Función para generar datos de estatura con diferentes distribuciones
generar_datos_estatura <- function(
tipo_distribucion = sample(c("simetrica", "sesgo_derecha", "sesgo_izquierda"), 1),
n = sample(9:25, 1)  # Permitir tamaños pares o impares
) {
# Configuraciones base según tipo de distribución
if (tipo_distribucion == "simetrica") {
base_min <- sample(145:155, 1)
base_max <- base_min + sample(30:40, 1)
medio <- (base_min + base_max) / 2
datos <- sort(round(rnorm(n, mean = medio, sd = (base_max - base_min) / 6)))
} else if (tipo_distribucion == "sesgo_derecha") {
base_min <- sample(145:155, 1)
base_max <- base_min + sample(35:45, 1)
# Generar con sesgo a la derecha (valores altos menos frecuentes)
datos <- sort(round(base_min + rbeta(n, 1, 3) * (base_max - base_min)))
} else { # sesgo_izquierda
base_min <- sample(145:155, 1)
base_max <- base_min + sample(35:45, 1)
# Generar con sesgo a la izquierda (valores bajos menos frecuentes)
datos <- sort(round(base_min + rbeta(n, 3, 1) * (base_max - base_min)))
}
# Asegurar que los datos no sean muy uniformes
if (length(unique(datos)) < n * 0.7) {
datos <- datos + sample(-3:3, n, replace = TRUE)
datos <- sort(datos)
}
# Calcular estadísticas usando el método tradicional
cuartiles <- calcular_cuartiles_tradicional(datos)
stats <- list(
datos = datos,
datos_desordenados = sample(datos),
minimo = min(datos),
q1 = cuartiles$q1,
mediana = cuartiles$q2,
q3 = cuartiles$q3,
maximo = max(datos),
rango_intercuartil = cuartiles$q3 - cuartiles$q1,
tipo_distribucion = tipo_distribucion
)
# Aplicar formato de un decimal a los cuartiles
stats$q1 <- round(stats$q1, 1)
stats$mediana <- round(stats$mediana, 1)
stats$q3 <- round(stats$q3, 1)
return(stats)
}
# Función para aplicar diferentes tipos de errores a los diagramas
aplicar_error <- function(stats, tipo_error) {
# Copiar los stats originales
valores <- stats
# Aplicar error según tipo
if (tipo_error == "q1_incorrecto") {
# Q1 muy bajo o muy alto
direccion <- sample(c(-1, 1), 1)
valores$q1 <- valores$q1 + direccion * round(valores$rango_intercuartil * runif(1, 0.3, 0.5))
} else if (tipo_error == "q3_incorrecto") {
# Q3 muy bajo o muy alto
direccion <- sample(c(-1, 1), 1)
valores$q3 <- valores$q3 + direccion * round(valores$rango_intercuartil * runif(1, 0.3, 0.5))
} else if (tipo_error == "mediana_incorrecta") {
# Mediana fuera de lugar pero dentro de la caja
if (runif(1) > 0.5) {
# Cerca de Q1
valores$mediana <- valores$q1 + (valores$mediana - valores$q1) * 0.2
} else {
# Cerca de Q3
valores$mediana <- valores$q3 - (valores$q3 - valores$mediana) * 0.2
}
} else if (tipo_error == "extremos_incorrectos") {
# Extremos acortados o elongados
if (runif(1) > 0.5) {
# Acortar
valores$minimo <- valores$minimo + round((valores$q1 - valores$minimo) * 0.4)
valores$maximo <- valores$maximo - round((valores$maximo - valores$q3) * 0.4)
} else {
# Elongar
rango <- valores$maximo - valores$minimo
valores$minimo <- valores$minimo - round(rango * 0.15)
valores$maximo <- valores$maximo + round(rango * 0.15)
}
} else if (tipo_error == "mediana_fuera") {
# Error estructural: mediana fuera de la caja
if (runif(1) > 0.5) {
# Por debajo de Q1
valores$mediana <- valores$q1 - round(valores$rango_intercuartil * runif(1, 0.2, 0.4))
} else {
# Por encima de Q3
valores$mediana <- valores$q3 + round(valores$rango_intercuartil * runif(1, 0.2, 0.4))
}
} else if (tipo_error == "caja_invertida") {
# Error estructural: Q1 y Q3 invertidos
temp <- valores$q1
valores$q1 <- valores$q3
valores$q3 <- temp
} else if (tipo_error == "bigote_incorrecto") {
# Bigotes que no terminan en datos reales
valores$minimo <- valores$minimo + sample(2:5, 1)
valores$maximo <- valores$maximo - sample(2:5, 1)
}
return(valores)
}
# Función para dibujar el diagrama
dibujar_diagrama <- function(valores, error_etiqueta = NULL) {
# Dibujar boxplot básico
segments(1, valores$minimo, 1, valores$maximo, lwd = 2)
# Dibujar la caja (rectángulo)
rect(0.8, valores$q1, 1.2, valores$q3, col = "white", border = "black")
# Dibujar la mediana
segments(0.8, valores$mediana, 1.2, valores$mediana, lwd = 2)
# Dibujar los bigotes
segments(0.8, valores$minimo, 1.2, valores$minimo, lwd = 2)
segments(0.8, valores$maximo, 1.2, valores$maximo, lwd = 2)
# Calcular espacios para evitar solapamiento de etiquetas
rango <- valores$maximo - valores$minimo
min_espacio <- rango * 0.18  # Aumentamos el espacio mínimo entre etiquetas
# Valores originales para las etiquetas
valores_orig <- c(valores$minimo, valores$q1, valores$mediana, valores$q3, valores$maximo)
etiquetas <- c(
paste("Mín =", valores$minimo),
paste("Q1 =", valores$q1),
paste("Q2 =", valores$mediana),
paste("Q3 =", valores$q3),
paste("Máx =", valores$maximo)
)
# Posiciones iniciales para las etiquetas
posiciones <- valores_orig
# Algoritmo mejorado para evitar solapamiento
for (i in 2:5) {
if (posiciones[i] - posiciones[i-1] < min_espacio) {
# Distribuir el espacio de manera más eficiente
espacio_actual <- posiciones[i] - posiciones[i-1]
ajuste_necesario <- min_espacio - espacio_actual
# Ajustar la posición actual hacia arriba
posiciones[i] <- posiciones[i] + ajuste_necesario
# Ajustar también todas las posiciones siguientes
if (i < 5) {
for (j in (i+1):5) {
posiciones[j] <- posiciones[j] + ajuste_necesario
}
}
}
}
# Si la última etiqueta se sale del rango visible, ajustar todas proporcionalmente
espacio_total_necesario <- posiciones[5] - posiciones[1]
espacio_disponible <- rango * 1.1  # Damos un 10% más de espacio
if (espacio_total_necesario > espacio_disponible) {
# Factor de compresión
factor <- espacio_disponible / espacio_total_necesario
# Comprimir proporcionalmente manteniendo la primera posición fija
for (i in 2:5) {
posiciones[i] <- posiciones[1] + (posiciones[i] - posiciones[1]) * factor
}
}
# Dibujar etiquetas con posiciones ajustadas
for (i in 1:5) {
text(1.3, posiciones[i], etiquetas[i], pos = 4, cex = 0.9)
}
# Si hay error en etiqueta, mostrarla
if (!is.null(error_etiqueta)) {
text(1, valores$maximo + rango * 0.1, error_etiqueta, col = "red", cex = 0.9)
}
}
# Función para verificar si dos diagramas son diferentes
son_diagramas_diferentes <- function(diag1, diag2) {
# Calculamos una métrica de diferencia para evaluar cuán diferentes son
diferencia_total <- abs(diag1$minimo - diag2$minimo) +
abs(diag1$q1 - diag2$q1) +
abs(diag1$mediana - diag2$mediana) +
abs(diag1$q3 - diag2$q3) +
abs(diag1$maximo - diag2$maximo)
# Verificar si al menos uno de los valores es diferente
resultado <- diag1$minimo != diag2$minimo ||
diag1$q1 != diag2$q1 ||
diag1$mediana != diag2$mediana ||
diag1$q3 != diag2$q3 ||
diag1$maximo != diag2$maximo
# Opcionalmente, podemos añadir un atributo a resultado para uso futuro
attr(resultado, "diferencia_total") <- diferencia_total
return(resultado)
}
# Función para verificar la diversidad de diagramas que podemos generar
verificar_diversidad_diagramas <- function(n_simulaciones = 1500) {
huellas_digitales <- character(n_simulaciones)
for (i in 1:n_simulaciones) {
# Generar datos aleatorios
stats <- generar_datos_estatura(
tipo_distribucion = sample(c("simetrica", "sesgo_derecha", "sesgo_izquierda"), 1),
n = sample(9:25, 1)
)
# Crear una huella digital basada en los valores clave
huella <- paste(
stats$minimo, stats$q1, stats$mediana,
stats$q3, stats$maximo, length(stats$datos),
stats$tipo_distribucion,
collapse = "_"
)
huellas_digitales[i] <- huella
}
# Contar cuántos diagramas únicos podemos generar
n_unicos <- length(unique(huellas_digitales))
return(list(
total_unicos = n_unicos,
suficiente_diversidad = n_unicos >= 300
))
}
# Ejecutar verificación al inicio
set.seed(NULL)  # Evitamos usar una semilla fija para asegurar mayor variabilidad
diversidad <- verificar_diversidad_diagramas(2000)
if (!diversidad$suficiente_diversidad) {
warning(paste("¡Advertencia! Solo se pueden generar", diversidad$total_unicos,
"diagramas diferentes. Se requieren al menos 300."))
}
# Generar conjunto de datos aleatorio con distribución aleatoria
set.seed(sample.int(1e5, 1))
tipo_distribucion <- sample(c("simetrica", "sesgo_derecha", "sesgo_izquierda"), 1)
stats <- generar_datos_estatura(tipo_distribucion)
# Aleatorizar qué diagrama será el correcto
posicion_correcto <- sample(1:4, 1)
# Categorías de errores disponibles
errores_por_categoria <- list(
valores = c("q1_incorrecto", "q3_incorrecto", "mediana_incorrecta", "extremos_incorrectos"),
estructura = c("mediana_fuera", "caja_invertida", "bigote_incorrecto"),
etiqueta = c("confundir_min_q1", "llamar_percentiles", "q4_incorrecto")
)
# Asegurar que hay un diagrama con error estructural
errores_seleccionados <- vector("list", 3)
# Seleccionar un error estructural para algún diagrama
errores_seleccionados[[1]] <- sample(errores_por_categoria$estructura, 1)
# Seleccionar un error de valores para algún diagrama
errores_seleccionados[[2]] <- sample(errores_por_categoria$valores, 1)
# Seleccionar un error de etiqueta para algún diagrama
errores_seleccionados[[3]] <- sample(errores_por_categoria$etiqueta, 1)
# Asignar al azar los diagramas
valores_diagramas <- vector("list", 4)
tipo_error_diagramas <- character(4)
indices_errores <- sample(1:3)
# Función para verificar y asegurar que los diagramas sean diferentes
asegurar_diagramas_diferentes <- function(valores_diagramas) {
# Vector para almacenar si todos los pares son diferentes
pares_diferentes <- logical(0)
# Verificar diferencias entre cada par
for (i in 1:3) {
for (j in (i+1):4) {
if (!is.null(valores_diagramas[[i]]) && !is.null(valores_diagramas[[j]])) {
# Añadir al vector si este par es diferente
pares_diferentes <- c(pares_diferentes,
son_diagramas_diferentes(valores_diagramas[[i]], valores_diagramas[[j]]))
} else {
# Si alguno es NULL, consideramos que no son diferentes
pares_diferentes <- c(pares_diferentes, FALSE)
}
}
}
# Verificar que todos los pares sean diferentes
return(all(pares_diferentes))
}
# Construir los diagramas
max_intentos <- 30  # Aumentar número de intentos
intentos <- 0
diagramas_diferentes <- FALSE
while (!diagramas_diferentes && intentos < max_intentos) {
intentos <- intentos + 1
# Reiniciar valores_diagramas
valores_diagramas <- vector("list", 4)
# Establecer el diagrama correcto
valores_diagramas[[posicion_correcto]] <- stats
tipo_error_diagramas[posicion_correcto] <- "ninguno"
# Crear los otros diagramas con errores
for (i in setdiff(1:4, posicion_correcto)) {
# Uso de índice simplificado para evitar problemas
error_indice <- if (i <= posicion_correcto) {
i
} else {
i - 1
}
error_indice <- (error_indice %% 3) + 1  # Asegurar que está entre 1 y 3
error_seleccionado <- errores_seleccionados[[error_indice]]
if (error_indice == 3) { # Error de etiqueta
valores_diagramas[[i]] <- stats
tipo_error_diagramas[i] <- "etiqueta"
} else {
# Aplicar un error que genere una diferencia significativa
# Intentar varias veces si es necesario
max_intentos_error <- 5
for (j in 1:max_intentos_error) {
nuevo_diagrama <- aplicar_error(stats, error_seleccionado)
# Verificar que este nuevo diagrama es diferente al correcto
if (son_diagramas_diferentes(stats, nuevo_diagrama)) {
break
}
# Si llegamos al último intento y no es diferente, aplicar una modificación
if (j == max_intentos_error) {
# Modificar manualmente para garantizar diferencia
nuevo_diagrama$q1 <- nuevo_diagrama$q1 + 2
nuevo_diagrama$q3 <- nuevo_diagrama$q3 - 2
}
}
valores_diagramas[[i]] <- nuevo_diagrama
if (error_indice == 1) {
tipo_error_diagramas[i] <- "estructura"
} else {
tipo_error_diagramas[i] <- "valores"
}
}
}
# Verificar que todos los diagramas son diferentes entre sí
diagramas_diferentes <- asegurar_diagramas_diferentes(valores_diagramas)
}
if (!diagramas_diferentes) {
warning("No se pudieron generar 4 diagramas suficientemente diferentes")
# Como plan B, forzar diferencias mínimas para asegurar diagramas distintos
for (i in 1:4) {
if (i != posicion_correcto) {
# Asegurar que al menos un valor sea diferente al del diagrama correcto
valores_diagramas[[i]]$q1 <- stats$q1 + i * 0.5
valores_diagramas[[i]]$q3 <- stats$q3 - i * 0.5
}
}
}
# Determinar qué diagrama tiene error estructural
diagrama_estructura_incorrecta <- which(tipo_error_diagramas == "estructura")
diagrama_etiqueta_incorrecta <- which(tipo_error_diagramas == "etiqueta")
# Calcular el límite global para los gráficos
todos_valores <- unlist(lapply(valores_diagramas, function(x)
c(x$minimo, x$q1, x$mediana, x$q3, x$maximo)))
y_min_global <- min(todos_valores) - 5
y_max_global <- max(todos_valores) + 5
# Analizar simetría de los datos para la pregunta 5
q1 <- stats$q1
q2 <- stats$mediana
q3 <- stats$q3
dist_q1_q2 <- q2 - q1
dist_q2_q3 <- q3 - q2
diferencia_cuartiles <- dist_q2_q3 - dist_q1_q2
# Determinar descripción de la simetría
if (abs(diferencia_cuartiles) < 3) {
descripcion_simetria <- "tiende a ser simétrica"
indice_respuesta_correcta <- 2
} else if (diferencia_cuartiles > 0) {
descripcion_simetria <- "presenta sesgo hacia valores más altos (positivo)"
indice_respuesta_correcta <- 3
} else {
descripcion_simetria <- "presenta sesgo hacia valores más bajos (negativo)"
indice_respuesta_correcta <- 4
}
# Calcular porcentaje aproximado de datos entre Q1 y Q3
# (Teóricamente 50%, pero puede aproximarse)
porcentaje_central <- 50
# Preparar soluciones para las preguntas
sol_p1 <- rep(0, 4)
sol_p1[posicion_correcto] <- 1
sol_p1_str <- paste(sol_p1, collapse="")
sol_p2 <- rep(0, 4)
sol_p2[diagrama_estructura_incorrecta] <- 1
sol_p2_str <- paste(sol_p2, collapse="")
sol_p4 <- c(0, 1, 0, 0) # Siempre es 50% aproximadamente
sol_p5 <- rep(0, 4)
sol_p5[indice_respuesta_correcta] <- 1
sol_p5_str <- paste(sol_p5, collapse="")
datos_tabla <- data.frame(
"Estudiante" = 1:length(stats$datos_desordenados),
"Estatura (cm)" = stats$datos_desordenados
)
tabla_xtable <- xtable(datos_tabla,
align = c("l", "c", "c"),
digits = c(0, 0, 0))
print(tabla_xtable,
type = "html",
include.rownames = FALSE,
html.table.attributes = 'border="1" cellpadding="5" cellspacing="0"')
# Diagrama A
par(mar = c(4, 4, 2, 6))
# Verificamos que el diagrama no esté vacío
if (is.null(valores_diagramas[[1]])) {
plot(NA, xlim = c(0.5, 1.5), ylim = c(y_min_global, y_max_global),
xlab = "", ylab = "Estatura (cm)", main = "Diagrama A", axes = FALSE)
text(1, (y_min_global + y_max_global)/2, "Error: Diagrama no generado", col = "red")
} else {
plot(NA, xlim = c(0.5, 1.5), ylim = c(y_min_global, y_max_global),
xlab = "", ylab = "Estatura (cm)", main = "Diagrama A", axes = FALSE)
if (tipo_error_diagramas[1] == "etiqueta") {
dibujar_diagrama(valores_diagramas[[1]], errores_seleccionados[[3]])
} else {
dibujar_diagrama(valores_diagramas[[1]])
}
}
# Diagrama B
par(mar = c(4, 4, 2, 6))
# Verificamos que el diagrama no esté vacío
if (is.null(valores_diagramas[[2]])) {
plot(NA, xlim = c(0.5, 1.5), ylim = c(y_min_global, y_max_global),
xlab = "", ylab = "Estatura (cm)", main = "Diagrama B", axes = FALSE)
text(1, (y_min_global + y_max_global)/2, "Error: Diagrama no generado", col = "red")
} else {
plot(NA, xlim = c(0.5, 1.5), ylim = c(y_min_global, y_max_global),
xlab = "", ylab = "Estatura (cm)", main = "Diagrama B", axes = FALSE)
if (tipo_error_diagramas[2] == "etiqueta") {
dibujar_diagrama(valores_diagramas[[2]], errores_seleccionados[[3]])
} else {
dibujar_diagrama(valores_diagramas[[2]])
}
}
# Diagrama C
par(mar = c(4, 4, 2, 6))
# Verificamos que el diagrama no esté vacío
if (is.null(valores_diagramas[[3]])) {
plot(NA, xlim = c(0.5, 1.5), ylim = c(y_min_global, y_max_global),
xlab = "", ylab = "Estatura (cm)", main = "Diagrama C", axes = FALSE)
text(1, (y_min_global + y_max_global)/2, "Error: Diagrama no generado", col = "red")
} else {
plot(NA, xlim = c(0.5, 1.5), ylim = c(y_min_global, y_max_global),
xlab = "", ylab = "Estatura (cm)", main = "Diagrama C", axes = FALSE)
if (tipo_error_diagramas[3] == "etiqueta") {
