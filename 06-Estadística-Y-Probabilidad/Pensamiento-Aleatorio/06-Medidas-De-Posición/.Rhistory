library(ggplot2)  # Para gráficos avanzados
library(testthat) # Para pruebas unitarias
library(digest)    # Para pruebas de diversidad de versiones
# Función de generación de datos
generar_datos <- function() {
# Documentación de parámetros y restricciones
# Se generan datos de estatura para un grupo de estudiantes.
# Las estaturas se distribuyen aproximadamente de forma normal.
# Se debe asegurar la generación de al menos 300 versiones únicas.
# Parámetros para la distribución de estaturas (en centímetros)
min_estatura <- 140
max_estatura <- 195
n_estudiantes <- 25 # Número fijo de estudiantes, menor que el número de nombres únicos
# Generar estaturas aleatorias
estaturas <- round(runif(n_estudiantes, min_estatura, max_estatura))
# Asegurar que al menos algunos datos estén cerca de los extremos
estaturas[1] <- min_estatura + sample(-2:2, 1)
estaturas[2] <- max_estatura + sample(-2:2, 1)
# Nombres aleatorios para los estudiantes (lista extendida)
nombres_hombres <- c("Juan", "Pedro", "Luis", "Carlos", "Miguel", "Andrés", "Diego", "David", "José", "Francisco", "Ricardo", "Javier", "Roberto", "Daniel", "Alejandro", "Sergio", "Pablo", "Jorge", "Alberto", "Fernando")
nombres_mujeres <- c("Ana", "María", "Luisa", "Laura", "Sofía", "Camila", "Isabela", "Valentina", "Paula", "Mariana", "Gabriela", "Andrea", "Carolina", "Daniela", "Fernanda", "Silvia", "Elena", "Patricia", "Raquel", "Beatriz")
# Asegurar nombres únicos y aleatorizar el conjunto de nombres disponibles
todos_los_nombres <- c(nombres_hombres, nombres_mujeres)
nombres_disponibles <- sample(todos_los_nombres, 30, replace = FALSE) # Seleccionar 30 nombres únicos
nombres <- sample(nombres_disponibles, n_estudiantes, replace = FALSE) # Muestrear sin reemplazo
#Asignar género aleatorio
generos <- sample(c("Hombre", "Mujer"), n_estudiantes, replace = TRUE)
# Crear data frame con los datos, asegurando el orden correcto de nombres
datos <- data.frame(
Nombre = nombres,
Genero = generos,
Estatura = estaturas,
stringsAsFactors = FALSE # Evitar la conversión automática a factor
)
# Ordenar los datos por estatura
datos <- datos[order(datos$Estatura), ]
# Convertir 'Nombre' a factor después de ordenar, manteniendo el orden
datos$Nombre <- factor(datos$Nombre, levels = unique(datos$Nombre))
# Retornar datos validados
return(datos)
}
# Generar datos
# set.seed() debe estar comentado para asegurar verdadera aleatoriedad
datos <- generar_datos()
# Cálculos adicionales y validaciones
# Calcular cuartiles
q1 <- quantile(datos$Estatura, 0.25)
q2 <- quantile(datos$Estatura, 0.50) # Mediana
q3 <- quantile(datos$Estatura, 0.75)
# Documentar cada paso
# Se generan datos de estatura y nombres aleatorios para un grupo de estudiantes.
# Se calculan los cuartiles Q1, Q2 (mediana) y Q3.
# Prueba de diversidad de versiones
test_that("Prueba de diversidad de versiones", {
# Generar y almacenar 1000 versiones
versiones <- list()
for(i in 1:1000) {
datos_test <- generar_datos()
versiones[[i]] <- digest::digest(datos_test)  # Crear hash de los datos
}
# Verificar al menos 300 versiones únicas
n_versiones_unicas <- length(unique(versiones))
expect_true(n_versiones_unicas >= 300,
info = paste("Solo se generaron", n_versiones_unicas,
"versiones únicas. Se requieren al menos 300."))
})
# Pruebas unitarias adicionales
test_that("Pruebas de validación de datos", {
# Pruebas de estructura
expect_true(is.data.frame(datos))
expect_equal(ncol(datos), 3)
expect_equal(names(datos), c("Nombre", "Genero", "Estatura"))
# Pruebas de rango
expect_true(all(datos$Estatura >= 138))
expect_true(all(datos$Estatura <= 197))
# Pruebas de distribución (se asume una distribución aproximadamente uniforme)
# (Esta prueba es más laxa debido a la naturaleza aleatoria)
expect_true(length(datos$Estatura) == 25)
# Casos límite
expect_true(min(datos$Estatura) >= 138) # 140 - 2
expect_true(max(datos$Estatura) <= 197) # 195 + 2
# Pruebas de relación entre variables
# (No hay pruebas específicas de relación en este caso)
})
# Preparación de visualización
# Alternar entre colores pastel y vivos entre versiones
paletas_colores <- list(
pastel = c("#fbb4ae", "#b3cde3", "#ccebc5", "#decbe4", "#fed9a6", "#ffffcc"),
vivos = c("#e41a1c", "#377eb8", "#4daf4a", "#984ea3", "#ff7f00", "#ffff33")
)
# Seleccionar aleatoriamente una paleta de colores
tipo_paleta <- sample(names(paletas_colores), 1)
colores <- paletas_colores[[tipo_paleta]]
# Crear el diagrama de caja
datos_ordenados <- datos[order(datos$Estatura),]
minimo <- min(datos_ordenados$Estatura)
q1 <- quantile(datos_ordenados$Estatura, 0.25)
mediana <- median(datos_ordenados$Estatura)
q3 <- quantile(datos_ordenados$Estatura, 0.75)
maximo <- max(datos_ordenados$Estatura)
# Configurar gráfico
par(mar = c(2, 4, 3, 2))
plot(NA, xlim = c(0.5, 1.5), ylim = c(minimo - 3, maximo + 3),
xaxt = "n", yaxt = "n", xlab = "", ylab = "",
bty = "n", main = "Diagrama de Caja de Estaturas")
# Dibujar el rectángulo principal (cuerpo del boxplot)
rect(0.75, q1, 1.25, q3, border = "black", col = colores[1])
# Dibujar la línea de la mediana
segments(0.75, mediana, 1.25, mediana, lwd = 2, col = colores[2])
# Dibujar los bigotes (whiskers)
segments(1, q1, 1, minimo, lwd = 1)  # Bigote inferior
segments(1, q3, 1, maximo, lwd = 1)  # Bigote superior
# Dibujar las líneas horizontales en los extremos de los bigotes
segments(0.85, minimo, 1.15, minimo, lwd = 1)  # Línea horizontal en mínimo
segments(0.85, maximo, 1.15, maximo, lwd = 1)  # Línea horizontal en máximo
# Agregar el eje Y con valores relevantes
secuencia_y <- seq(floor(minimo - 1), ceiling(maximo + 1), by = 1)
axis(2, at = secuencia_y, las = 1, cex.axis = 0.7)
# Agregar etiquetas para los cuartiles, mínimo y máximo
text(1.35, q1, "Q1", cex = 0.8)
text(1.35, mediana, "Q2", cex = 0.8)
text(1.35, q3, "Q3", cex = 0.8)
text(1.35, minimo, "Mín.", cex = 0.8)
text(1.35, maximo, "Máx.", cex = 0.8)
# Dibujar el borde del gráfico
box()
# Documentar decisiones de diseño
# Se utiliza un diagrama de caja para visualizar la distribución de estaturas.
# Se alternan esquemas de color entre versiones para mejorar la diversidad visual.
# Crear el diagrama de caja
datos_ordenados <- datos[order(datos$Estatura),]
minimo <- min(datos_ordenados$Estatura)
q1 <- quantile(datos_ordenados$Estatura, 0.25)
mediana <- median(datos_ordenados$Estatura)
q3 <- quantile(datos_ordenados$Estatura, 0.75)
maximo <- max(datos_ordenados$Estatura)
# Configurar gráfico
par(mar = c(2, 4, 3, 2))
plot(NA, xlim = c(0.5, 1.5), ylim = c(minimo - 3, maximo + 3),
xaxt = "n", yaxt = "n", xlab = "", ylab = "",
bty = "n", main = "Diagrama de Caja de Estaturas")
# Dibujar el rectángulo principal (cuerpo del boxplot)
rect(0.75, q1, 1.25, q3, border = "black", col = colores[1])
# Dibujar la línea de la mediana
segments(0.75, mediana, 1.25, mediana, lwd = 2, col = colores[2])
# Dibujar los bigotes (whiskers)
segments(1, q1, 1, minimo, lwd = 1)  # Bigote inferior
segments(1, q3, 1, maximo, lwd = 1)  # Bigote superior
# Dibujar las líneas horizontales en los extremos de los bigotes
segments(0.85, minimo, 1.15, minimo, lwd = 1)  # Línea horizontal en mínimo
segments(0.85, maximo, 1.15, maximo, lwd = 1)  # Línea horizontal en máximo
# Agregar el eje Y con valores relevantes
secuencia_y <- seq(floor(minimo - 1), ceiling(maximo + 1), by = 1)
axis(2, at = secuencia_y, las = 1, cex.axis = 0.7)
# Agregar etiquetas para los cuartiles, mínimo y máximo
text(1.35, q1, "Q1", cex = 0.8)
text(1.35, mediana, "Q2", cex = 0.8)
text(1.35, q3, "Q3", cex = 0.8)
text(1.35, minimo, "Mín.", cex = 0.8)
text(1.35, maximo, "Máx.", cex = 0.8)
# Dibujar el borde del gráfico
box()
