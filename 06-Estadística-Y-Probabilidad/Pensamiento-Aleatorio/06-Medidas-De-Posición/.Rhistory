text(1.3, valores$q3, paste("Q3 =", valores$q3), pos = 4, cex = 0.8)
text(1.3, valores$maximo, paste("Máx =", valores$maximo), pos = 4, cex = 0.8)
# Si hay valores atípicos y se solicita mostrarlos
if (mostrar_atipicos && "atipicos" %in% names(valores) && length(valores$atipicos) > 0) {
points(rep(1, length(valores$atipicos)), valores$atipicos, pch = 19, col = "red", cex = 1.2)
text(rep(1.3, length(valores$atipicos)), valores$atipicos,
paste("Atípico =", valores$atipicos), pos = 4, cex = 0.8, col = "red")
}
# Ejes y marco
axis(2, las = 1)
box()
}
# Generar datos iniciales
set.seed(1234) # Para reproducibilidad en este ejemplo
stats <- generar_datos_estatura()
# Asegurar que tengamos al menos un valor atípico para hacerlo más interesante
if (!stats$tiene_atipicos) {
# Añadir un valor atípico artificial si no hay ninguno naturalmente
ric <- stats$q3 - stats$q1
stats$datos <- c(stats$datos, round(stats$q3 + 2 * ric))
stats$datos_desordenados <- sample(stats$datos)
stats$maximo <- max(stats$datos)
stats$atipicos <- stats$datos[stats$datos > (stats$q3 + 1.5 * ric)]
stats$tiene_atipicos <- TRUE
}
# Calcular valores para cada tipo de diagrama
valores_correcto <- calcular_valores_diagrama(stats, "correcto")
valores_mediana_ric <- calcular_valores_diagrama(stats, "mediana_correcta_ric_modificado")
valores_cuartiles <- calcular_valores_diagrama(stats, "cuartiles_correctos_extremos_incorrectos")
valores_metodo_diferente <- calcular_valores_diagrama(stats, "metodo_cuartiles_diferente")
# Calcular límites globales para todos los gráficos
y_min_global <- min(
valores_correcto$y_min,
valores_mediana_ric$y_min,
valores_cuartiles$y_min,
valores_metodo_diferente$y_min
)
y_max_global <- max(
valores_correcto$y_max,
valores_mediana_ric$y_max,
valores_cuartiles$y_max,
valores_metodo_diferente$y_max
)
# Calcular valores específicos para las preguntas
diferencia_q1 <- abs(valores_metodo_diferente$valores$q1 - stats$q1)
error_porcentual_ric <- round(abs((valores_mediana_ric$valores$q3 - valores_mediana_ric$valores$q1 - stats$rango_intercuartil)/stats$rango_intercuartil * 100), 1)
error_extremos <- abs(valores_cuartiles$valores$maximo - stats$maximo)
coeficiente_asimetria <- round((stats$q3 - stats$mediana) - (stats$mediana - stats$q1), 1)
# Determinar cuál diagrama tiene mayor sesgo visible
asimetria_diagramas <- c(
A = abs((valores_correcto$valores$q3 - valores_correcto$valores$mediana) -
(valores_correcto$valores$mediana - valores_correcto$valores$q1)),
B = abs((valores_mediana_ric$valores$q3 - valores_mediana_ric$valores$mediana) -
(valores_mediana_ric$valores$mediana - valores_mediana_ric$valores$q1)),
C = abs((valores_cuartiles$valores$q3 - valores_cuartiles$valores$mediana) -
(valores_cuartiles$valores$mediana - valores_cuartiles$valores$q1)),
D = abs((valores_metodo_diferente$valores$q3 - valores_metodo_diferente$valores$mediana) -
(valores_metodo_diferente$valores$mediana - valores_metodo_diferente$valores$q1))
)
diagrama_mas_simetrico <- names(which.min(asimetria_diagramas))
datos_tabla <- data.frame(
"Estudiante" = 1:length(stats$datos_desordenados),
"Estatura (cm)" = stats$datos_desordenados
)
tabla_xtable <- xtable(datos_tabla,
align = c("l", "c", "c"),
digits = c(0, 0, 0))
print(tabla_xtable,
type = "html",
include.rownames = FALSE,
html.table.attributes = 'border="1" cellpadding="5" cellspacing="0"')
par(mar = c(4, 4, 2, 6))
plot(NA, xlim = c(0.5, 1.5), ylim = c(y_min_global, y_max_global),
xlab = "", ylab = "Estatura (cm)", main = "Diagrama A", axes = FALSE)
dibujar_diagrama(valores_correcto$valores)
par(mar = c(4, 4, 2, 6))
plot(NA, xlim = c(0.5, 1.5), ylim = c(y_min_global, y_max_global),
xlab = "", ylab = "Estatura (cm)", main = "Diagrama B", axes = FALSE)
dibujar_diagrama(valores_mediana_ric$valores)
par(mar = c(4, 4, 2, 6))
plot(NA, xlim = c(0.5, 1.5), ylim = c(y_min_global, y_max_global),
xlab = "", ylab = "Estatura (cm)", main = "Diagrama C", axes = FALSE)
dibujar_diagrama(valores_cuartiles$valores)
par(mar = c(4, 4, 2, 6))
plot(NA, xlim = c(0.5, 1.5), ylim = c(y_min_global, y_max_global),
xlab = "", ylab = "Estatura (cm)", main = "Diagrama D", axes = FALSE)
dibujar_diagrama(valores_metodo_diferente$valores)
library(exams)
library(xtable)
knitr::opts_chunk$set(echo = FALSE, warning = FALSE, message = FALSE)
# Función para generar datos de estatura (simplificada)
generar_datos_estatura <- function(
base_min = sample(145:165, 1),
base_max = sample(168:188, 1),
n = sample(seq(7, 19, 2), 1)  # Reducido a conjunto más pequeño
) {
# Generar datos más simples y con distribución más clara
variacion <- sample(5:10, 1)
min_valor <- base_min - sample(0:variacion, 1)
max_valor <- base_max + sample(0:variacion, 1)
# Datos más equilibrados
datos <- sort(round(runif(n, min_valor, max_valor), digits = 0))
# Calcular estadísticas básicas
stats <- list(
datos = datos,
datos_desordenados = sample(datos),
minimo = min(datos),
q1 = quantile(datos, 0.25, type = 1),
mediana = median(datos),
q3 = quantile(datos, 0.75, type = 1),
maximo = max(datos),
rango_intercuartil = as.numeric(quantile(datos, 0.75, type = 1) - quantile(datos, 0.25, type = 1))
)
return(stats)
}
# Función para crear diagramas enfocados en conceptos básicos
calcular_valores_diagrama <- function(stats, tipo = "correcto") {
# Configuración base del gráfico
rango <- stats$maximo - stats$minimo
# Modificar valores según tipo de diagrama (conceptos básicos)
valores <- switch(tipo,
# Diagrama completamente correcto
"correcto" = stats,
# Diagrama con valores incorrectos (error común de cálculo)
"valores_incorrectos" = {
tmp <- stats
# Error común: usar posiciones incorrectas para Q1 y Q3
tmp$q1 <- stats$datos[ceiling(length(stats$datos) * 0.25)] # Posición sin ordenar
tmp$q3 <- stats$datos[ceiling(length(stats$datos) * 0.75)] # Posición sin ordenar
tmp
},
# Diagrama con mediana fuera de la caja (error conceptual)
"estructura_incorrecta" = {
tmp <- stats
# Error conceptual: mediana fuera del rango de Q1-Q3
tmp$mediana <- tmp$q1 - round(tmp$rango_intercuartil * 0.2)
tmp
},
# Diagrama con etiquetas incorrectas (error de nomenclatura)
"etiquetas_incorrectas" = {
# Este no cambia valores, solo cambiará las etiquetas al dibujarlo
stats
}
)
# Calcular límites y para el gráfico según los valores modificados
y_min <- min(valores$minimo, stats$minimo) - rango * 0.15
y_max <- max(valores$maximo, stats$maximo) + rango * 0.15
# Devolver los valores y límites calculados
return(list(
valores = valores,
y_min = y_min,
y_max = y_max,
tipo = tipo
))
}
# Función para dibujar el diagrama
dibujar_diagrama <- function(valores) {
# Dibujar boxplot básico
segments(1, valores$valores$minimo, 1, valores$valores$maximo, lwd = 2)
rect(0.8, valores$valores$q1, 1.2, valores$valores$q3, col = "white", border = "black")
segments(0.8, valores$valores$mediana, 1.2, valores$valores$mediana, lwd = 2)
segments(c(0.8, 0.8), c(valores$valores$minimo, valores$valores$maximo),
c(1.2, 1.2), c(valores$valores$minimo, valores$valores$maximo), lwd = 2)
# Agregar etiquetas según el tipo de diagrama
if (valores$tipo == "etiquetas_incorrectas") {
# Etiquetas incorrectas (error común: confundir Q1 con mínimo)
text(1.3, valores$valores$minimo, paste("Q1 =", valores$valores$minimo), pos = 4, cex = 0.8)
text(1.3, valores$valores$q1, paste("Percentil 15 =", valores$valores$q1), pos = 4, cex = 0.8)
text(1.3, valores$valores$mediana, paste("Q2 =", valores$valores$mediana), pos = 4, cex = 0.8)
text(1.3, valores$valores$q3, paste("Percentil 85 =", valores$valores$q3), pos = 4, cex = 0.8)
text(1.3, valores$valores$maximo, paste("Q4 =", valores$valores$maximo), pos = 4, cex = 0.8)
} else {
# Etiquetas normales
text(1.3, valores$valores$minimo, paste("Mín =", valores$valores$minimo), pos = 4, cex = 0.8)
text(1.3, valores$valores$q1, paste("Q1 =", valores$valores$q1), pos = 4, cex = 0.8)
text(1.3, valores$valores$mediana, paste("Q2 =", valores$valores$mediana), pos = 4, cex = 0.8)
text(1.3, valores$valores$q3, paste("Q3 =", valores$valores$q3), pos = 4, cex = 0.8)
text(1.3, valores$valores$maximo, paste("Máx =", valores$valores$maximo), pos = 4, cex = 0.8)
}
# Ejes y marco
axis(2, las = 1)
box()
}
# Generar datos iniciales
set.seed(1234) # Para reproducibilidad
stats <- generar_datos_estatura()
# Calcular valores para cada tipo de diagrama
valores_correcto <- calcular_valores_diagrama(stats, "correcto")
valores_incorrectos <- calcular_valores_diagrama(stats, "valores_incorrectos")
valores_estructura <- calcular_valores_diagrama(stats, "estructura_incorrecta")
valores_etiquetas <- calcular_valores_diagrama(stats, "etiquetas_incorrectas")
# Calcular límites globales para todos los gráficos
y_min_global <- min(
valores_correcto$y_min,
valores_incorrectos$y_min,
valores_estructura$y_min,
valores_etiquetas$y_min
)
y_max_global <- max(
valores_correcto$y_max,
valores_incorrectos$y_max,
valores_estructura$y_max,
valores_etiquetas$y_max
)
# Cálculos básicos para las preguntas
q2_menos_q1 <- stats$mediana - stats$q1
q3_menos_q2 <- stats$q3 - stats$mediana
valor_central <- round(mean(c(stats$minimo, stats$maximo)))
porcentaje_central <- round(length(stats$datos[stats$datos >= stats$q1 & stats$datos <= stats$q3]) / length(stats$datos) * 100)
datos_tabla <- data.frame(
"Estudiante" = 1:length(stats$datos_desordenados),
"Estatura (cm)" = stats$datos_desordenados
)
tabla_xtable <- xtable(datos_tabla,
align = c("l", "c", "c"),
digits = c(0, 0, 0))
print(tabla_xtable,
type = "html",
include.rownames = FALSE,
html.table.attributes = 'border="1" cellpadding="5" cellspacing="0"')
