stats_base$mediana + desplazamiento))
# Distractor 2: Cuartiles incorrectos
distractor2 <- stats_base
factor_q1 <- runif(1, 0.8, 1.2)
factor_q3 <- runif(1, 0.8, 1.2)
distractor2$q1 <- max(rango_seleccionado[1],
min(stats_base$mediana - 1, stats_base$q1 * factor_q1))
distractor2$q3 <- min(rango_seleccionado[2],
max(stats_base$mediana + 1, stats_base$q3 * factor_q3))
# Distractor 3: Rango incorrecto
distractor3 <- stats_base
factor_rango <- runif(1, 0.7, 1.3)
centro <- (stats_base$minimo + stats_base$maximo) / 2
nuevo_rango <- (stats_base$maximo - stats_base$minimo) * factor_rango
distractor3$minimo <- max(rango_seleccionado[1], centro - nuevo_rango/2)
distractor3$maximo <- min(rango_seleccionado[2], centro + nuevo_rango/2)
return(list(distractor1, distractor2, distractor3))
}
distractores <- generar_distractores(stats_correctas)
# Crear lista de todas las opciones y mezclarlas
todas_opciones <- c(list(stats_correctas), distractores)
names(todas_opciones) <- c("correcta", "distractor1", "distractor2", "distractor3")
opciones_mezcladas <- sample(todas_opciones)
# Identificar la posición de la respuesta correcta
indice_correcto <- which(names(opciones_mezcladas) == "correcta")
# Crear el vector de solución para r-exams
solucion <- rep(0, 4)
solucion[indice_correcto] <- 1
# Validaciones matemáticas
test_that("Los datos están en el rango correcto", {
expect_true(all(datos_principales >= rango_seleccionado[1]))
expect_true(all(datos_principales <= rango_seleccionado[2]))
})
test_that("Las estadísticas son coherentes", {
expect_true(stats_correctas$minimo <= stats_correctas$q1)
expect_true(stats_correctas$q1 <= stats_correctas$mediana)
expect_true(stats_correctas$mediana <= stats_correctas$q3)
expect_true(stats_correctas$q3 <= stats_correctas$maximo)
})
# Aleatorización de términos para el enunciado
terminos_tabla <- c("cuadro", "registro", "listado")
